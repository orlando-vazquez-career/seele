---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Observability from '../components/Observability.astro';
import ChatPanel from '../components/ChatPanel.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="SEELE — observability"
  description="Live observability panel for your local SEELE memory engine. Stats, recent saves, full-text search, by-type and by-project breakdowns, 14-day save sparkline. Reads directly from the local HTTP server."
>
  <Header />
  <main>
    <section class="obs-page">
      <div class="page-container-centered">
        <aside class="obs-banner" role="note">
          <span class="obs-banner-tag">// LOCAL-ONLY</span>
          <p class="obs-banner-text">
            <span lang="en">This panel and the chat below read from <strong>your own</strong> <code>seele serve</code> on <code>localhost:7777</code>. The hosted site has no database of its own — without your local server running, you see sample data and the chat panel asks you to plug in your own AI key. Setup: <code>cargo install --path crates/seele-cli</code>, then <code>seele serve --cors-allow {Astro.url.origin}</code>.</span><span lang="es">Este panel y el chat de abajo leen desde <strong>tu propio</strong> <code>seele serve</code> en <code>localhost:7777</code>. El sitio público no tiene base de datos propia — sin tu servidor local corriendo vas a ver datos de muestra y el chat te va a pedir tu propia API key. Setup: <code>cargo install --path crates/seele-cli</code>, después <code>seele serve --cors-allow {Astro.url.origin}</code>.</span>
          </p>
        </aside>

        <header class="obs-page-header">
          <span class="obs-page-eyebrow"><span lang="en">// OBSERVABILITY</span><span lang="es">// OBSERVABILIDAD</span></span>
          <h1 class="obs-page-title">
            <span lang="en">What your<br />memory engine<br />is doing.</span><span lang="es">Lo que está<br />haciendo tu<br />memoria.</span>
          </h1>
          <p class="obs-page-lead">
            <span lang="en">No telemetry ever leaves your machine — neither database reads nor chat keys.</span><span lang="es">Cero telemetría sale de tu máquina — ni lecturas de base ni keys de chat.</span>
          </p>
        </header>

        <Observability />
        <ChatPanel />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .obs-page {
    padding-block: var(--space-14) var(--space-20);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .obs-banner {
    display: block;
    border: var(--border-base) solid var(--accent);
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-10);
    background: transparent;
  }

  .obs-banner-tag {
    display: block;
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2);
  }

  .obs-banner-text {
    font-size: var(--text-sm);
    color: var(--fg);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .obs-banner-text strong {
    color: var(--accent);
    font-weight: var(--weight-bold);
  }

  .obs-banner-text code {
    background: transparent;
    border-bottom: var(--border-hair) solid var(--fg-faint);
    padding: 0 4px;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .obs-page-header {
    margin-bottom: var(--space-10);
    max-width: 60ch;
  }

  .obs-page-eyebrow {
    display: block;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .obs-page-title {
    font-size: clamp(32px, 5.5vw, var(--text-hero));
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin-bottom: var(--space-6);
  }

  .obs-page-lead {
    font-size: var(--text-base);
    color: var(--fg-muted);
    line-height: var(--leading-relaxed);
  }

  .obs-page-lead code {
    background: transparent;
    border-bottom: var(--border-hair) solid var(--fg-faint);
    padding: 0 4px;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
</style>
