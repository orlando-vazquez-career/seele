---
/**
 * ChatPanel — chat-with-DB widget for the /observability page.
 *
 * Talks to SEELE's local `POST /chat` endpoint, which runs a tool-use loop
 * server-side: the model decides when to call `seele_search`, the server
 * executes the search, feeds results back to the model, and only the final
 * assistant text returns to the browser. The user's AI API key is stored
 * in this browser's localStorage and only forwarded to the SEELE server
 * on this machine — it never reaches a third party from this page.
 *
 * Three states:
 *
 *   1. probing       — checking /chat/info + localStorage
 *   2. needs-config  — neither server config nor stored settings present
 *   3. enabled       — chat works; provider + model are shown
 *
 * In needs-config we render an [ OPEN SETTINGS ] CTA that pops a dialog
 * for provider / api key / model / endpoint.
 */

interface Props {
  endpoint?: string;
}

const { endpoint = 'http://localhost:7777' } = Astro.props;
---

<section class="chat" data-chat data-endpoint={endpoint} data-state="probing">
  <header class="chat-header">
    <span class="chat-eyebrow"><span lang="en">// CHAT</span><span lang="es">// CHAT</span></span>
    <span class="chat-meta" data-chat-meta></span>
    <button
      type="button"
      class="chat-gear"
      data-chat-gear
      aria-label="Configure chat provider"
      title="Configure chat provider"
    >[ ⚙ ]</button>
  </header>

  <!-- probing -->
  <div class="chat-state" data-show-when="probing">
    <p class="chat-msg"><span lang="en">probing /chat…</span><span lang="es">sondeando /chat…</span></p>
  </div>

  <!-- needs config (no key set anywhere) -->
  <div class="chat-state" data-show-when="needs-config">
    <p class="chat-msg">
      <span class="msg-strong"><span lang="en">configure your AI provider to start</span><span lang="es">configurá tu proveedor IA para empezar</span></span>
    </p>
    <p class="chat-detail">
      <span lang="en">Click <span class="inline-gear">[ ⚙ ]</span> above. Provider + API key are stored in this browser's localStorage and sent only to the SEELE server on this machine. The key never reaches a third party from this page.</span><span lang="es">Hacé click en <span class="inline-gear">[ ⚙ ]</span> arriba. El provider + API key se guardan en el localStorage de este browser y se envían solo al servidor SEELE local. La key nunca llega a terceros desde esta página.</span>
    </p>
    <button type="button" class="chat-open-settings" data-chat-open-settings>
      <span lang="en">[ OPEN SETTINGS ]</span><span lang="es">[ ABRIR AJUSTES ]</span>
    </button>
  </div>

  <!-- enabled -->
  <div class="chat-state" data-show-when="enabled">
    <ol class="chat-log" data-chat-log></ol>

    <form class="chat-form" data-chat-form>
      <textarea
        class="chat-input"
        data-chat-input
        rows="2"
        placeholder="ask your memories…"
        data-placeholder-en="ask your memories…"
        data-placeholder-es="preguntá a tus memorias…"
        aria-label="chat input"
      ></textarea>
      <button class="chat-send" type="submit" data-chat-send>
        <span lang="en">SEND</span><span lang="es">ENVIAR</span>
      </button>
    </form>

    <p class="chat-status" data-chat-status></p>
  </div>

  <!-- Settings dialog (always present, hidden by default) -->
  <dialog class="chat-settings" data-chat-settings aria-label="Chat provider settings">
    <form class="chat-settings-form" data-chat-settings-form method="dialog">
      <header class="chat-settings-header">
        <span class="chat-settings-eyebrow"><span lang="en">// CHAT · SETTINGS</span><span lang="es">// CHAT · AJUSTES</span></span>
        <button type="button" class="chat-settings-close" data-chat-settings-close aria-label="Close">[ × ]</button>
      </header>

      <label class="chat-field">
        <span class="chat-field-label"><span lang="en">provider</span><span lang="es">proveedor</span></span>
        <select name="provider" data-chat-field-provider required>
          <option value="minimax">minimax</option>
          <option value="openai">openai</option>
          <option value="anthropic">anthropic</option>
          <option value="openrouter">openrouter</option>
          <option value="together">together</option>
          <option value="groq">groq</option>
          <option value="deepseek">deepseek</option>
        </select>
      </label>

      <label class="chat-field">
        <span class="chat-field-label"><span lang="en">model</span><span lang="es">modelo</span></span>
        <input type="text" name="model" data-chat-field-model placeholder="auto · uses provider default" />
      </label>

      <label class="chat-field">
        <span class="chat-field-label"><span lang="en">api key</span><span lang="es">api key</span></span>
        <input type="password" name="api_key" data-chat-field-key placeholder="sk-…" autocomplete="off" required />
      </label>

      <label class="chat-field">
        <span class="chat-field-label"><span lang="en">endpoint override (optional)</span><span lang="es">endpoint override (opcional)</span></span>
        <input type="text" name="endpoint" data-chat-field-endpoint placeholder="leave empty for default" />
      </label>

      <p class="chat-settings-note">
        <span lang="en">Stored in browser localStorage. Sent only to <code data-chat-settings-endpoint-display></code> on each request. Clear by leaving the key field empty + save.</span><span lang="es">Guardado en localStorage del browser. Se envía solo a <code data-chat-settings-endpoint-display></code> en cada request. Para borrarlo, dejá el campo de key vacío y guardá.</span>
      </p>

      <div class="chat-settings-actions">
        <button type="button" class="chat-settings-cancel" data-chat-settings-cancel>
          <span lang="en">CANCEL</span><span lang="es">CANCELAR</span>
        </button>
        <button type="submit" class="chat-settings-save">
          <span lang="en">SAVE</span><span lang="es">GUARDAR</span>
        </button>
      </div>
    </form>
  </dialog>
</section>

<script>
  type ChatInfo = {
    enabled: boolean;
    provider: string | null;
    model: string | null;
  };

  type ToolCall = {
    id: string;
    function: { name: string; arguments: string };
  };

  type Message = {
    role: string;
    content: string | null;
    tool_calls?: ToolCall[];
    tool_call_id?: string;
    name?: string;
  };

  type State = 'probing' | 'needs-config' | 'enabled';

  type ChatSettings = {
    provider: string;
    api_key: string;
    model: string;
    endpoint: string;
  };

  const TIMEOUT_MS = 60_000;
  const SETTINGS_KEY = 'seele-chat-settings';

  const DEFAULT_MODELS: Record<string, string> = {
    minimax: 'MiniMax-M2',
    openai: 'gpt-4o-mini',
    openrouter: 'openai/gpt-4o-mini',
    together: 'meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo',
    groq: 'llama-3.3-70b-versatile',
    deepseek: 'deepseek-chat',
    anthropic: 'claude-haiku-4-5-20251001',
  };

  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) initChat(root);

  function loadSettings(): ChatSettings | null {
    try {
      const raw = localStorage.getItem(SETTINGS_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Partial<ChatSettings>;
      if (!parsed.provider || !parsed.api_key) return null;
      return {
        provider: parsed.provider,
        api_key: parsed.api_key,
        model: parsed.model || '',
        endpoint: parsed.endpoint || '',
      };
    } catch {
      return null;
    }
  }

  function saveSettings(s: ChatSettings) {
    localStorage.setItem(SETTINGS_KEY, JSON.stringify(s));
  }

  function clearSettings() {
    localStorage.removeItem(SETTINGS_KEY);
  }

  async function initChat(root: HTMLElement) {
    const endpoint = (root.dataset.endpoint || 'http://localhost:7777').replace(/\/$/, '');

    // Reflect endpoint in the settings dialog note
    root
      .querySelectorAll<HTMLElement>('[data-chat-settings-endpoint-display]')
      .forEach((el) => (el.textContent = endpoint));

    bindGear(root);
    bindSettingsDialog(root, endpoint);

    setState(root, 'probing');
    const info = await probeChatInfo(endpoint);
    const localSettings = loadSettings();

    // Enabled if either the server has chat config OR the browser has saved
    // settings. Browser settings take precedence at request time.
    if ((info && info.enabled) || localSettings) {
      setState(root, 'enabled');
      const provider = localSettings?.provider || info?.provider || '?';
      const model =
        localSettings?.model ||
        DEFAULT_MODELS[provider] ||
        info?.model ||
        '?';
      setMeta(root, `${provider} · ${model}`);
      bindForm(root, endpoint);
      return;
    }
    setState(root, 'needs-config');
  }

  function setState(root: HTMLElement, status: State) {
    root.dataset.state = status;
    root.querySelectorAll<HTMLElement>('[data-show-when]').forEach((el) => {
      el.hidden = el.dataset.showWhen !== status;
    });
  }

  function setMeta(root: HTMLElement, text: string) {
    const m = root.querySelector<HTMLElement>('[data-chat-meta]');
    if (m) m.textContent = text;
  }

  async function probeChatInfo(endpoint: string): Promise<ChatInfo | null> {
    try {
      const res = await fetch(`${endpoint}/chat/info`, {
        cache: 'no-store',
        signal: AbortSignal.timeout(3_000),
      });
      if (!res.ok) return null;
      return (await res.json()) as ChatInfo;
    } catch {
      return null;
    }
  }

  function bindGear(root: HTMLElement) {
    const gear = root.querySelector<HTMLButtonElement>('[data-chat-gear]');
    const openBtn = root.querySelector<HTMLButtonElement>('[data-chat-open-settings]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-chat-settings]');
    if (!dialog) return;

    const open = () => {
      hydrateFormFromStorage(root);
      if (typeof dialog.showModal === 'function') dialog.showModal();
      else dialog.setAttribute('open', '');
    };

    gear?.addEventListener('click', open);
    openBtn?.addEventListener('click', open);
  }

  function hydrateFormFromStorage(root: HTMLElement) {
    const s = loadSettings();
    const provider = root.querySelector<HTMLSelectElement>('[data-chat-field-provider]');
    const model = root.querySelector<HTMLInputElement>('[data-chat-field-model]');
    const key = root.querySelector<HTMLInputElement>('[data-chat-field-key]');
    const ep = root.querySelector<HTMLInputElement>('[data-chat-field-endpoint]');
    if (s) {
      if (provider) provider.value = s.provider;
      if (model) model.value = s.model;
      if (key) key.value = s.api_key;
      if (ep) ep.value = s.endpoint;
    } else {
      // sensible defaults for first open
      if (provider && !provider.value) provider.value = 'minimax';
      if (model) model.value = '';
      if (key) key.value = '';
      if (ep) ep.value = '';
    }
  }

  function bindSettingsDialog(root: HTMLElement, endpoint: string) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-chat-settings]');
    const form = root.querySelector<HTMLFormElement>('[data-chat-settings-form]');
    const close = root.querySelector<HTMLButtonElement>('[data-chat-settings-close]');
    const cancel = root.querySelector<HTMLButtonElement>('[data-chat-settings-cancel]');
    if (!dialog || !form) return;

    const closeDialog = () => {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
    };

    close?.addEventListener('click', closeDialog);
    cancel?.addEventListener('click', closeDialog);

    // Click outside dialog content closes it
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const provider = String(fd.get('provider') || '').trim();
      const api_key = String(fd.get('api_key') || '').trim();
      const model = String(fd.get('model') || '').trim();
      const endpointOverride = String(fd.get('endpoint') || '').trim();

      // Empty api_key → clear settings (deliberate UX to wipe credentials)
      if (!api_key) {
        clearSettings();
        closeDialog();
        location.reload();
        return;
      }

      saveSettings({ provider, api_key, model, endpoint: endpointOverride });
      closeDialog();
      location.reload();
    });
  }

  function bindForm(root: HTMLElement, endpoint: string) {
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]');
    const input = root.querySelector<HTMLTextAreaElement>('[data-chat-input]');
    const log = root.querySelector<HTMLElement>('[data-chat-log]');
    const send = root.querySelector<HTMLButtonElement>('[data-chat-send]');
    const status = root.querySelector<HTMLElement>('[data-chat-status]');
    if (!form || !input || !log || !send || !status) return;

    const history: Message[] = [];

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = input.value.trim();
      if (!q) return;
      input.value = '';
      input.disabled = true;
      send.disabled = true;
      status.textContent = '';
      status.dataset.state = '';

      const userMsg: Message = { role: 'user', content: q };
      history.push(userMsg);
      renderMessage(log, userMsg);

      try {
        setStatus(status, 'thinking…', 'thinking');
        const settings = loadSettings();
        const body: Record<string, unknown> = { messages: history };
        if (settings) {
          body.provider = settings.provider;
          body.api_key = settings.api_key;
          if (settings.model) body.model = settings.model;
          if (settings.endpoint) body.endpoint = settings.endpoint;
        }
        const res = await fetch(`${endpoint}/chat`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          cache: 'no-store',
          signal: AbortSignal.timeout(TIMEOUT_MS),
          body: JSON.stringify(body),
        });
        if (!res.ok) {
          const text = await res.text();
          setStatus(status, `error: ${text.slice(0, 120)}`, 'error');
          return;
        }
        const data = (await res.json()) as { messages: Message[]; provider: string; model: string };

        // The server returns the FULL history including the system + tool
        // messages. Diff against `history` and render new turns in order.
        const newTurns = data.messages.slice(history.length + 1); // +1 skips the system prompt the server prepends
        for (const m of newTurns) {
          history.push(m);
          renderMessage(log, m);
        }
        setStatus(status, '', '');
      } catch (err) {
        const msg = (err as { message?: string }).message ?? String(err);
        setStatus(status, `error: ${msg}`, 'error');
      } finally {
        input.disabled = false;
        send.disabled = false;
        input.focus();
      }
    });

    // Enter sends, Shift+Enter inserts a newline. Skip while IME composing.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
        e.preventDefault();
        form.requestSubmit();
      }
    });
  }

  function setStatus(el: HTMLElement, text: string, state: string) {
    el.textContent = text;
    el.dataset.state = state;
  }

  function renderMessage(log: HTMLElement, m: Message) {
    if (m.role === 'system') return; // never display

    const li = document.createElement('li');
    li.className = `turn turn-${m.role}`;

    if (m.role === 'user') {
      li.innerHTML = `
        <span class="turn-tag">// you</span>
        <div class="turn-body">${escapeHtml(m.content ?? '')}</div>
      `;
    } else if (m.role === 'assistant') {
      const parts: string[] = [];
      parts.push(`<span class="turn-tag">// ai</span>`);
      const cleaned = stripThinking(m.content ?? '');
      if (cleaned) parts.push(`<div class="turn-body">${renderAssistantBody(cleaned)}</div>`);
      if (m.tool_calls && m.tool_calls.length > 0) {
        for (const tc of m.tool_calls) {
          let args = '';
          try {
            const parsed = JSON.parse(tc.function.arguments);
            args = parsed.query ? `"${parsed.query}"` : tc.function.arguments;
          } catch {
            args = tc.function.arguments;
          }
          parts.push(
            `<span class="tool-call">→ ${escapeHtml(tc.function.name)}(${escapeHtml(args)})</span>`,
          );
        }
      }
      // If everything got stripped and there are no tool calls, drop the turn entirely
      if (parts.length === 1) return;
      li.innerHTML = parts.join('');
    } else if (m.role === 'tool') {
      // Compact tool result: just say how many results came back if it's a search
      let summary = '(result)';
      try {
        const parsed = JSON.parse(m.content ?? '{}');
        if (typeof parsed.count === 'number') {
          summary = `${parsed.count} results`;
        }
      } catch {
        summary = (m.content ?? '').slice(0, 80);
      }
      li.innerHTML = `
        <span class="turn-tag">// tool</span>
        <div class="turn-body turn-tool-body">${escapeHtml(summary)}</div>
      `;
    } else {
      li.innerHTML = `<span class="turn-tag">// ${escapeHtml(m.role)}</span><div class="turn-body">${escapeHtml(m.content ?? '')}</div>`;
    }

    log.appendChild(li);
    // Scroll INSIDE the log container only — never let the page scroll.
    log.scrollTop = log.scrollHeight;
  }

  function stripThinking(s: string): string {
    // Reasoning models emit thinking traces inside ad-hoc tags that should
    // never reach the user. Patterns seen in the wild:
    //   <think>…</think>          — Minimax M2, DeepSeek-R1, Qwen QwQ
    //   <thinking>…</thinking>    — older Claude-style passthrough
    //   <|thinking|>…<|/thinking|> — some Together / vLLM templates
    return s
      .replace(/<think>[\s\S]*?<\/think>/gi, '')
      .replace(/<thinking>[\s\S]*?<\/thinking>/gi, '')
      .replace(/<\|thinking\|>[\s\S]*?<\|\/thinking\|>/gi, '')
      .trim();
  }

  function renderAssistantBody(text: string): string {
    // 1. Escape first (defence in depth — no markdown can ever inject HTML).
    let s = escapeHtml(text);
    // 2. Light markdown on the escaped string.
    //    Bold: **text** → <strong>text</strong>
    s = s.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
    //    Inline code: `text` → <code>text</code>
    s = s.replace(/`([^`\n]+)`/g, '<code>$1</code>');
    return s;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
</script>

<style>
  .chat {
    font-family: var(--font-mono);
    color: var(--fg);
    border: var(--border-base) solid var(--semantic-border-base);
    padding: var(--space-4);
    background: var(--bg);
    margin-top: var(--space-8);
  }

  .chat-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-hair) solid var(--semantic-border-muted);
  }

  .chat-eyebrow {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .chat-meta {
    font-size: 12px;
    color: var(--fg-faint);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .chat-state[hidden] {
    display: none !important;
  }

  .chat-msg {
    font-size: var(--text-sm);
    margin: 0 0 var(--space-2);
    color: var(--fg-muted);
  }

  .msg-strong {
    color: var(--fg);
    font-weight: var(--weight-bold);
  }

  .chat-detail {
    font-size: var(--text-xs);
    color: var(--fg-faint);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-2);
  }

  .chat-detail-small {
    font-size: 12px;
    color: var(--fg-faint);
    line-height: var(--leading-relaxed);
    margin: var(--space-2) 0 0;
  }

  .chat-detail code,
  .chat-detail-small code {
    color: var(--fg);
    padding: 0 4px;
    border-bottom: var(--border-hair) solid var(--fg-faint);
  }

  .chat-cmd {
    margin: var(--space-2) 0;
    padding: var(--space-3);
    border: var(--border-hair) solid var(--semantic-border-muted);
    font-size: var(--text-xs);
    color: var(--fg);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  /* Message log */
  .chat-log {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    max-height: 480px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .turn {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: var(--border-hair) solid var(--semantic-border-muted);
  }

  .turn:first-child {
    padding-top: 0;
  }

  .turn:last-child {
    border-bottom: 0;
  }

  .turn-tag {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
  }

  .turn-user .turn-tag { color: var(--fg-muted); }
  .turn-assistant .turn-tag { color: var(--accent); }
  .turn-tool .turn-tag { color: var(--fg-faint); }

  .turn-body {
    font-size: var(--text-sm);
    color: var(--fg);
    line-height: var(--leading-relaxed);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    padding-left: var(--space-3);
    border-left: var(--border-hair) solid var(--semantic-border-muted);
  }

  .turn-assistant .turn-body {
    border-left-color: var(--accent);
  }

  .turn-body strong {
    font-weight: var(--weight-bold);
    color: var(--fg);
  }

  .turn-body code {
    font-family: inherit;
    color: var(--fg);
    padding: 0 4px;
    border-bottom: var(--border-hair) solid var(--fg-faint);
  }

  .turn-tool-body {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  .tool-call {
    display: block;
    font-size: var(--text-xs);
    color: var(--fg-faint);
    padding-left: var(--space-3);
    border-left: var(--border-hair) solid var(--fg-faint);
  }

  /* Form */
  .chat-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2);
    align-items: stretch;
  }

  .chat-input {
    width: 100%;
    padding: var(--space-3);
    background: transparent;
    color: var(--fg);
    border: var(--border-hair) solid var(--semantic-border-muted);
    font-family: inherit;
    font-size: var(--text-sm);
    resize: vertical;
    min-height: 56px;
  }

  .chat-input:focus {
    outline: var(--border-hair) solid var(--accent);
    outline-offset: 0;
    border-color: var(--accent);
  }

  .chat-input::placeholder {
    color: var(--fg-faint);
  }

  .chat-send {
    align-self: stretch;
    padding: 0 var(--space-4);
    background: var(--accent);
    color: var(--bg);
    border: var(--border-base) solid var(--accent);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    cursor: pointer;
  }

  .chat-send:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .chat-send:hover:not(:disabled) {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

