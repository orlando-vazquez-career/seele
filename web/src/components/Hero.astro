---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero-inner">
    <h1 class="hero-title">SEELE</h1>
    <p class="hero-tagline">Memoria local para tus agentes de IA.</p>
    <p class="hero-subline">
      Rust · SQLite · Hybrid FTS + sqlite-vec + ONNX embeddings · RRF.
      <br />
      One binary, three transports: <code>CLI</code> · <code>MCP</code> · <code>HTTP</code>.
    </p>
    <div class="hero-ctas">
      <a class="cta cta-primary" href="#install">▶ Get started</a>
      <a
        class="cta cta-secondary"
        href="https://github.com/orlando-vazquez-career/seele"
        rel="noopener"
        target="_blank"
      >
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="hero-status">
      <span class="status-dot" aria-hidden="true"></span>
      v0.1.0 released · 322 tests green · MIT license
    </p>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-24) var(--space-6) var(--space-16);
    display: flex;
    justify-content: center;
  }

  .hero-inner {
    max-width: 720px;
    text-align: center;
  }

  .hero-title {
    font-size: var(--text-3xl);
    letter-spacing: 0.08em;
    color: var(--semantic-text-primary);
    margin-bottom: var(--space-4);
  }

  .hero-tagline {
    font-size: var(--text-xl);
    color: var(--semantic-text-primary);
    margin-bottom: var(--space-4);
  }

  .hero-subline {
    font-size: var(--text-sm);
    color: var(--semantic-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  .hero-subline code {
    color: var(--semantic-text-accent);
    background: var(--semantic-surface-elevated);
    padding: 1px 6px;
    border-radius: var(--rounded-sm);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--rounded-md);
    text-decoration: none;
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    transition: background var(--duration-fast) var(--easing-standard),
      transform var(--duration-fast) var(--easing-standard);
  }

  .cta-primary {
    background: var(--semantic-action-primary-bg);
    color: var(--semantic-action-primary-text);
  }

  .cta-primary:hover {
    background: var(--semantic-action-primary-bg-hover);
    transform: translateY(-1px);
  }

  .cta-secondary {
    background: var(--semantic-action-secondary-bg);
    color: var(--semantic-action-secondary-text);
    border: 1px solid var(--semantic-border-strong);
  }

  .cta-secondary:hover {
    background: var(--semantic-action-secondary-bg-hover);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--semantic-text-tertiary);
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: var(--rounded-pill);
    background: var(--semantic-text-success);
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--space-12) var(--space-4) var(--space-8);
    }
    .hero-title {
      font-size: var(--text-2xl);
    }
    .hero-tagline {
      font-size: var(--text-lg);
    }
  }
</style>
