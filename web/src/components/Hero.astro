---
import SeeleStatus from './SeeleStatus.astro';
---

<section class="hero">
  <div class="page-container hero-inner">
    <div class="hero-meta">
      <span class="hero-meta-label">// SEELE</span>
      <span class="hero-meta-version">[v0.2.0]</span>
    </div>

    <h1 class="hero-title">
      <span lang="en">Memory engine<br />for AI tools<br />that need to remember.</span><span lang="es">Motor de memoria<br />para herramientas IA<br />que recuerdan.</span>
    </h1>

    <p class="hero-subline">
      <span lang="en">Local-first. Rust + SQLite + FTS5 + sqlite-vec + ONNX embeddings.<br />One binary, three transports: CLI · MCP · HTTP.</span><span lang="es">Local-first. Rust + SQLite + FTS5 + sqlite-vec + embeddings ONNX.<br />Un binario, tres transportes: CLI · MCP · HTTP.</span>
    </p>

    <div class="hero-data">
      <div class="data-row">
        <span class="data-label"><span lang="en">latency</span><span lang="es">latencia</span></span>
        <span class="data-value">&lt; 5ms p99</span>
      </div>
      <div class="data-row">
        <span class="data-label">backend</span>
        <span class="data-value">Rust 1.85+</span>
      </div>
      <div class="data-row">
        <span class="data-label">tests</span>
        <span class="data-value"><span lang="en">322 green</span><span lang="es">322 verdes</span></span>
      </div>
      <div class="data-row">
        <span class="data-label"><span lang="en">status</span><span lang="es">estado</span></span>
        <span class="data-value accent">ALPHA</span>
      </div>
      <div class="data-row">
        <span class="data-label"><span lang="en">license</span><span lang="es">licencia</span></span>
        <span class="data-value">MIT</span>
      </div>
    </div>

    <div class="hero-ctas">
      <a class="cta cta-primary" href="#install">
        <span lang="en">[&nbsp;INSTALL NOW&nbsp;]</span><span lang="es">[&nbsp;INSTALAR&nbsp;]</span>
      </a>
      <a
        class="cta cta-secondary"
        href="https://github.com/orlando-vazquez-career/seele"
        rel="noopener"
        target="_blank"
      >
        [&nbsp;GITHUB ↗&nbsp;]
      </a>
    </div>

    <div class="hero-status-row">
      <SeeleStatus />
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .hero-inner {
    padding-block: var(--space-20) var(--space-14);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .hero-meta-label {
    color: var(--accent);
  }

  .hero-title {
    /* Lower bound 28px fits at 320px viewport. Upper bound caps at
       --text-hero (64px in v0.4.1) — was 84px in v0.4.0, too dominant. */
    font-size: clamp(28px, 5.5vw, var(--text-hero));
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin-bottom: var(--space-8);
    max-width: 18ch;
    overflow-wrap: anywhere;
  }

  .hero-subline {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--fg-muted);
    margin-bottom: var(--space-10);
    max-width: 60ch;
  }

  .hero-data {
    /* Bordes incompletos: top + right + bottom, NO left (connects to left margin) */
    border-top: var(--border-base) solid var(--semantic-border-base);
    border-right: var(--border-base) solid var(--semantic-border-base);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
    border-left: 0;
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-10);
    margin-left: var(--space-14);
    max-width: 480px;
  }

  .data-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
  }

  .data-row + .data-row {
    border-top: var(--border-hair) solid var(--semantic-border-muted);
  }

  .data-label {
    color: var(--fg-muted);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    font-size: var(--text-meta);
  }

  .data-value {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }

  .data-value.accent {
    color: var(--accent);
    font-weight: var(--weight-bold);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-base) solid;
  }

  .cta-primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .cta-primary:hover {
    background: var(--bg);
    color: var(--accent);
    padding: var(--space-3) var(--space-6);
  }

  .cta-secondary {
    background: transparent;
    color: var(--fg);
    border-color: var(--fg);
  }

  .cta-secondary:hover {
    background: var(--fg);
    color: var(--bg);
    padding: var(--space-3) var(--space-6);
  }

  .hero-status-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-block: var(--space-10) var(--space-8);
    }
    .hero-data {
      margin-left: var(--space-4);
    }
  }
</style>
