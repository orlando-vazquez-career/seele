---
/**
 * Triangle — DevZen brand motif preserved minimally in Brutalist v0.3.
 *
 * Used ONLY in Header brand mark (24px, framed). NO gradient interior.
 * Solid off-white fill (or accent on hover). Replaces the v0.2 multi-stop
 * gradient version with simple, brutal geometry.
 */

interface Props {
  /** Size in pixels (square) */
  size?: number;
  /** Variant: framed (default — small brand mark) | outline (rare) */
  variant?: 'framed' | 'outline';
  /** Extra class */
  class?: string;
  /** Decorative — hides from screen readers */
  decorative?: boolean;
}

const {
  size = 24,
  variant = 'framed',
  class: className = '',
  decorative = true,
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class={`triangle ${className}`}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
>
  {variant === 'framed' ? (
    <>
      <rect
        x="1"
        y="1"
        width="22"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <polygon
        points="12,5 19,18 5,18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linejoin="miter"
      />
    </>
  ) : (
    <polygon
      points="12,3 21,20 3,20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="miter"
    />
  )}
</svg>

<style>
  .triangle {
    display: inline-block;
    flex-shrink: 0;
  }
</style>
