            <span class="recent-title">ONNX model auto-download via hf-hub</span>
            <span class="recent-meta"><span class="recent-type">architecture</span><span class="recent-sep">·</span><span class="recent-project">seele</span><span class="recent-sep">·</span><span class="recent-age">5h ago</span></span>
          </li>
        </ol>
      </section>
      <section class="obs-section">
        <span class="obs-section-eyebrow">// BY PROJECT</span>
        <ol class="bars">
          <li class="bar-row"><span class="bar-key">seele</span><span class="bar-track"><span class="bar-fill" style="width:100%"></span></span><span class="bar-count">68</span></li>
          <li class="bar-row"><span class="bar-key">mnema</span><span class="bar-track"><span class="bar-fill" style="width:63%"></span></span><span class="bar-count">43</span></li>
          <li class="bar-row"><span class="bar-key">akiveo</span><span class="bar-track"><span class="bar-fill" style="width:31%"></span></span><span class="bar-count">21</span></li>
          <li class="bar-row"><span class="bar-key">default</span><span class="bar-track"><span class="bar-fill" style="width:15%"></span></span><span class="bar-count">10</span></li>
        </ol>
      </section>
      <section class="obs-section">
        <span class="obs-section-eyebrow">// SAVES (LAST 14 DAYS)</span>
        <div class="spark">
          <span class="spark-bars">▁▂▁▃▂▄▃▅▄▆▅▇▆█</span>
          <span class="spark-meta">142 saves · last 14d</span>
        </div>
      </section>
    </div>
  </div>

  <!-- CORS blocked — same preview as offline + explicit fix instruction at top -->
  <div class="obs-state obs-state-cors" data-show-when="cors-blocked">
    <div class="preview-banner">
      <span class="preview-label">CORS BLOCKED · sample data</span>
      <p class="preview-note">
        SEELE is up but rejects cross-origin reads. Restart with:
      </p>
      <pre class="obs-cmd"><code>$ seele serve --cors-allow {endpoint.replace(/\/$/, '')}</code></pre>
    </div>
    <div class="obs-preview-grid">
      <section class="obs-section">
        <span class="obs-section-eyebrow">// STATS</span>
        <div class="stats-grid">
          <div class="stat"><span class="stat-label">total</span><span class="stat-value">142</span></div>
          <div class="stat"><span class="stat-label">projects</span><span class="stat-value">4</span></div>
          <div class="stat"><span class="stat-label">last save</span><span class="stat-value">23m</span></div>
        </div>
      </section>
      <section class="obs-section">
        <span class="obs-section-eyebrow">// BY TYPE</span>
        <ol class="bars">
          <li class="bar-row"><span class="bar-key">decision</span><span class="bar-track"><span class="bar-fill" style="width:100%"></span></span><span class="bar-count">38</span></li>
          <li class="bar-row"><span class="bar-key">pattern</span><span class="bar-track"><span class="bar-fill" style="width:74%"></span></span><span class="bar-count">28</span></li>
          <li class="bar-row"><span class="bar-key">bugfix</span><span class="bar-track"><span class="bar-fill" style="width:53%"></span></span><span class="bar-count">20</span></li>
          <li class="bar-row"><span class="bar-key">discovery</span><span class="bar-track"><span class="bar-fill" style="width:38%"></span></span><span class="bar-count">14</span></li>
          <li class="bar-row"><span class="bar-key">learning</span><span class="bar-track"><span class="bar-fill" style="width:25%"></span></span><span class="bar-count">9</span></li>
        </ol>
      </section>
      <section class="obs-section">
        <span class="obs-section-eyebrow">// RECENT</span>
        <ol class="recent">
          <li class="recent-item recent-static">
            <span class="recent-title">RRF combiner: weight tuning for hybrid search</span>
            <span class="recent-meta"><span class="recent-type">pattern</span><span class="recent-sep">·</span><span class="recent-project">seele</span><span class="recent-sep">·</span><span class="recent-age">23m ago</span></span>
          </li>
          <li class="recent-item recent-static">
            <span class="recent-title">Migrate ENGRAM SQLite via seele import from-engram</span>
            <span class="recent-meta"><span class="recent-type">decision</span><span class="recent-sep">·</span><span class="recent-project">seele</span><span class="recent-sep">·</span><span class="recent-age">2h ago</span></span>
          </li>
          <li class="recent-item recent-static">
            <span class="recent-title">ONNX model auto-download via hf-hub</span>
            <span class="recent-meta"><span class="recent-type">architecture</span><span class="recent-sep">·</span><span class="recent-project">seele</span><span class="recent-sep">·</span><span class="recent-age">5h ago</span></span>
          </li>
        </ol>
      </section>
      <section class="obs-section">
        <span class="obs-section-eyebrow">// BY PROJECT</span>
        <ol class="bars">
          <li class="bar-row"><span class="bar-key">seele</span><span class="bar-track"><span class="bar-fill" style="width:100%"></span></span><span class="bar-count">68</span></li>
          <li class="bar-row"><span class="bar-key">mnema</span><span class="bar-track"><span class="bar-fill" style="width:63%"></span></span><span class="bar-count">43</span></li>
          <li class="bar-row"><span class="bar-key">akiveo</span><span class="bar-track"><span class="bar-fill" style="width:31%"></span></span><span class="bar-count">21</span></li>
          <li class="bar-row"><span class="bar-key">default</span><span class="bar-track"><span class="bar-fill" style="width:15%"></span></span><span class="bar-count">10</span></li>
        </ol>
      </section>
      <section class="obs-section">
        <span class="obs-section-eyebrow">// SAVES (LAST 14 DAYS)</span>
        <div class="spark">
          <span class="spark-bars">▁▂▁▃▂▄▃▅▄▆▅▇▆█</span>
          <span class="spark-meta">142 saves · last 14d</span>
        </div>
      </section>
    </div>
  </div>

  <!-- Online state — all sections appear here -->
  <div class="obs-state obs-state-online" data-show-when="online">

    <!-- Stats grid -->
    <section class="obs-section">
      <span class="obs-section-eyebrow">// STATS</span>
      <div class="stats-grid">
        <div class="stat">
          <span class="stat-label">total</span>
          <span class="stat-value" data-stat-total>—</span>
        </div>
        <div class="stat">
          <span class="stat-label">projects</span>
          <span class="stat-value" data-stat-projects>—</span>
        </div>
        <div class="stat">
          <span class="stat-label">last save</span>
          <span class="stat-value" data-stat-last>—</span>
        </div>
      </div>
    </section>

    <!-- By type -->
    <section class="obs-section">
      <span class="obs-section-eyebrow">// BY TYPE</span>
      <ol class="bars" data-bars-type>
        <li class="bars-empty">no data</li>
      </ol>
    </section>

    <!-- By project -->
    <section class="obs-section">
      <span class="obs-section-eyebrow">// BY PROJECT</span>
      <ol class="bars" data-bars-project>
