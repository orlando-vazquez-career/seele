    <!-- Search -->
    <section class="obs-section">
      <span class="obs-section-eyebrow">// SEARCH</span>
      <input
        class="search-input"
        type="search"
        placeholder="query…"
        data-search-input
        aria-label="Search memories"
      />
      <ol class="results" data-search-results></ol>
    </section>

    <!-- Recent -->
    <section class="obs-section">
      <span class="obs-section-eyebrow">// RECENT</span>
      <ol class="recent" data-recent>
        <li class="bars-empty">no data</li>
      </ol>
    </section>

    <!-- Sparkline -->
    <section class="obs-section">
      <span class="obs-section-eyebrow">// SAVES (LAST 14 DAYS)</span>
      <div class="spark" data-spark>
        <span class="spark-bars" data-spark-bars></span>
        <span class="spark-meta" data-spark-meta>—</span>
      </div>
    </section>

    <!-- Detail panel (hidden until item clicked) -->
    <section class="obs-section obs-detail-panel" data-detail-panel hidden>
      <button type="button" class="detail-close" data-detail-close aria-label="Close detail">[ × CLOSE ]</button>
      <span class="obs-section-eyebrow" data-detail-eyebrow>// DETAIL</span>
      <h4 class="detail-title" data-detail-title></h4>
      <dl class="detail-meta" data-detail-meta></dl>
      <pre class="detail-content"><code data-detail-content></code></pre>
    </section>

  </div>
</aside>

<script>
  type Status =
    | 'probing'
    | 'offline'
    | 'cors-blocked'
    | 'online';

  type MemoryRecord = {
    id: string;
    title: string;
    type: string;
    project: string | null;
    scope: string | null;
    topic_key: string | null;
    content: string;
    created_at: number;
    updated_at: number;
    revision_count?: number;
    metadata?: Record<string, unknown> | null;
  };

  type StatsResponse = {
    observations: {
      active: number;
      deleted: number;
      projects: number;
      by_type: Array<{ key: string; count: number }>;
      by_scope: Array<{ key: string; count: number }>;
    };
    sessions: { total: number; by_status: Array<{ key: string; count: number }> };
  };

  const TIMEOUT_MS = 1500;
  const POLL_INTERVAL_MS = 15_000;
  const RECENT_LIMIT = 10;
  const SPARK_DAYS = 14;
  const SPARK_BLOCKS = '▁▂▃▄▅▆▇█';

  const root = document.querySelector<HTMLElement>('[data-obs]');
  if (root) initObservability(root);

  function initObservability(root: HTMLElement) {
    const endpoint = (root.dataset.endpoint || 'http://localhost:7777').replace(/\/$/, '');

    setState(root, 'probing');

    void probeAndStart(root, endpoint);
  }

  function setState(root: HTMLElement, status: Status) {
    root.dataset.state = status;
    root.querySelectorAll<HTMLElement>('[data-show-when]').forEach((el) => {
      el.hidden = el.dataset.showWhen !== status;
    });
  }

  async function probeAndStart(root: HTMLElement, endpoint: string) {
    const status = await probe(endpoint);
    setState(root, status);
    if (status !== 'online') return;
    await refreshAll(root, endpoint);
    window.setInterval(() => void refreshAll(root, endpoint), POLL_INTERVAL_MS);
    bindSearch(root, endpoint);
  }

  async function probe(endpoint: string): Promise<Status> {
    // First try a readable cross-origin GET. If CORS is configured the
    // browser exposes the body. If not, the fetch throws — we then fall
    // back to a no-cors probe to distinguish "server is down" from
    // "server is up but CORS blocked".
    try {
      const res = await fetch(`${endpoint}/health`, {
        cache: 'no-store',
        signal: AbortSignal.timeout(TIMEOUT_MS),
      });
      if (!res.ok) return 'offline';
      return 'online';
    } catch {
      // First fetch failed. Could be (a) server down, (b) CORS rejection.
      // Distinguish via no-cors probe — it won't expose the body but it
      // succeeds when the server responds at all.
      try {
        await fetch(`${endpoint}/health`, {
          mode: 'no-cors',
          cache: 'no-store',
          signal: AbortSignal.timeout(TIMEOUT_MS),
        });
        return 'cors-blocked';
      } catch {
        return 'offline';
      }
    }
  }

  async function refreshAll(root: HTMLElement, endpoint: string) {
    await Promise.allSettled([
      refreshStats(root, endpoint),
      refreshRecent(root, endpoint),
    ]);
  }

  async function fetchJson<T>(url: string): Promise<T | null> {
    try {
      const res = await fetch(url, {
        cache: 'no-store',
        signal: AbortSignal.timeout(TIMEOUT_MS),
      });
      if (!res.ok) return null;
      return (await res.json()) as T;
    } catch {
      return null;
    }
  }

  async function refreshStats(root: HTMLElement, endpoint: string) {
    const stats = await fetchJson<StatsResponse>(`${endpoint}/stats`);
    if (!stats) return;
    const obs = stats.observations;
    const total = obs.active;
    const projects = obs.projects;

    setText(root, '[data-stat-total]', String(total));
    setText(root, '[data-stat-projects]', String(projects));

    renderBars(root, '[data-bars-type]', obs.by_type, total);
  }

  async function refreshRecent(root: HTMLElement, endpoint: string) {
    const memories = await fetchJson<MemoryRecord[]>(
      `${endpoint}/memories?limit=${RECENT_LIMIT}`,
    );
    if (!memories) return;
    renderRecent(root, memories);

    if (memories.length > 0) {
      const last = memories[0]!;
      setText(root, '[data-stat-last]', relativeAge(last.created_at));
    }

    renderProjectBars(root, memories);
    renderSparkline(root, memories);
  }

  function renderRecent(root: HTMLElement, memories: MemoryRecord[]) {
    const ol = root.querySelector<HTMLElement>('[data-recent]');
    if (!ol) return;
    if (memories.length === 0) {
      ol.innerHTML = '<li class="bars-empty">no memories yet</li>';
      return;
    }
    ol.innerHTML = '';
    for (const m of memories) {
      const li = document.createElement('li');
      li.className = 'recent-item';
      li.tabIndex = 0;
      li.setAttribute('role', 'button');
      li.dataset.memoryId = m.id;
      li.innerHTML = `
        <span class="recent-title">${escapeHtml(truncate(m.title, 60))}</span>
        <span class="recent-meta">
          <span class="recent-type">${escapeHtml(m.type)}</span>
          <span class="recent-sep">·</span>
          <span class="recent-project">${escapeHtml(m.project ?? '—')}</span>
          <span class="recent-sep">·</span>
          <span class="recent-age">${escapeHtml(relativeAge(m.created_at))}</span>
        </span>
      `;
      li.addEventListener('click', () => showDetail(root, m));
      li.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          showDetail(root, m);
        }
      });
      ol.appendChild(li);
    }
  }

  function renderBars(
    root: HTMLElement,
    selector: string,
    items: Array<{ key: string; count: number }>,
    total: number,
  ) {
    const ol = root.querySelector<HTMLElement>(selector);
    if (!ol) return;
    if (items.length === 0) {
      ol.innerHTML = '<li class="bars-empty">no data</li>';
      return;
    }
    const max = Math.max(...items.map((i) => i.count), 1);
    ol.innerHTML = '';
    for (const it of items.slice(0, 6)) {
      const pct = Math.max((it.count / max) * 100, 4);
      const li = document.createElement('li');
      li.className = 'bar-row';
      li.innerHTML = `
        <span class="bar-key">${escapeHtml(it.key)}</span>
        <span class="bar-track">
          <span class="bar-fill" style="width: ${pct.toFixed(1)}%"></span>
        </span>
        <span class="bar-count">${it.count}</span>
      `;
      ol.appendChild(li);
    }
  }

  function renderProjectBars(root: HTMLElement, memories: MemoryRecord[]) {
    const counts = new Map<string, number>();
    for (const m of memories) {
      const k = m.project ?? '—';
      counts.set(k, (counts.get(k) ?? 0) + 1);
    }
    const items = Array.from(counts.entries())
      .map(([key, count]) => ({ key, count }))
      .sort((a, b) => b.count - a.count);
    renderBars(root, '[data-bars-project]', items, memories.length);
  }

  function renderSparkline(root: HTMLElement, memories: MemoryRecord[]) {
    const bars = root.querySelector<HTMLElement>('[data-spark-bars]');
    const meta = root.querySelector<HTMLElement>('[data-spark-meta]');
    if (!bars || !meta) return;
    if (memories.length === 0) {
      bars.textContent = SPARK_BLOCKS[0].repeat(SPARK_DAYS);
      meta.textContent = '0 saves total';
      return;
    }
    const now = Date.now();
    const buckets = new Array<number>(SPARK_DAYS).fill(0);
    let inWindow = 0;
    for (const m of memories) {
      const ageDays = Math.floor((now - m.created_at) / (1000 * 60 * 60 * 24));
      if (ageDays >= 0 && ageDays < SPARK_DAYS) {
        const idx = SPARK_DAYS - 1 - ageDays;
        buckets[idx] = (buckets[idx] ?? 0) + 1;
        inWindow++;
      }
    }
    const max = Math.max(...buckets, 1);
    const out = buckets
      .map((b) => {
        const idx = b === 0 ? 0 : Math.min(SPARK_BLOCKS.length - 1, Math.ceil((b / max) * (SPARK_BLOCKS.length - 1)));
        return SPARK_BLOCKS[idx];
      })
      .join('');
    bars.textContent = out;
    meta.textContent = `${inWindow} saves · last ${SPARK_DAYS}d`;
  }

  function showDetail(root: HTMLElement, m: MemoryRecord) {
    const panel = root.querySelector<HTMLElement>('[data-detail-panel]');
    if (!panel) return;
    setText(root, '[data-detail-title]', m.title);
    const meta = root.querySelector<HTMLElement>('[data-detail-meta]');
    if (meta) {
      meta.innerHTML = `
        <dt>id</dt><dd>${escapeHtml(m.id)}</dd>
        <dt>type</dt><dd>${escapeHtml(m.type)}</dd>
        <dt>project</dt><dd>${escapeHtml(m.project ?? '—')}</dd>
        <dt>topic</dt><dd>${escapeHtml(m.topic_key ?? '—')}</dd>
        <dt>created</dt><dd>${escapeHtml(new Date(m.created_at).toISOString())}</dd>
      `;
    }
    setText(root, '[data-detail-content]', m.content);
    panel.hidden = false;
    panel.scrollIntoView({ behavior: 'auto', block: 'nearest' });

    const closeBtn = root.querySelector<HTMLButtonElement>('[data-detail-close]');
    closeBtn?.addEventListener(
      'click',
      () => {
        panel.hidden = true;
      },
      { once: true },
    );
  }

  function bindSearch(root: HTMLElement, endpoint: string) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLElement>('[data-search-results]');
    if (!input || !results) return;
    let abortPrev: AbortController | null = null;
    let debounceTimer: number | null = null;
    input.addEventListener('input', () => {
      if (debounceTimer) window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(async () => {
        const q = input.value.trim();
        if (q.length < 2) {
          results.innerHTML = '';
          return;
        }
        if (abortPrev) abortPrev.abort();
        abortPrev = new AbortController();
        try {
          const res = await fetch(`${endpoint}/search`, {
            method: 'POST',
            cache: 'no-store',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ query: q, limit: 8 }),
            signal: abortPrev.signal,
          });
          if (!res.ok) {
            results.innerHTML = '<li class="bars-empty">search failed</li>';
            return;
          }
          const data = (await res.json()) as { results?: Array<{ memory: MemoryRecord; score?: number }> };
          renderSearchResults(root, results, data.results ?? []);
        } catch (err) {
          if ((err as { name?: string }).name !== 'AbortError') {
            results.innerHTML = '<li class="bars-empty">search error</li>';
          }
        }
      }, 220);
    });
  }

  function renderSearchResults(
    root: HTMLElement,
    el: HTMLElement,
    items: Array<{ memory: MemoryRecord; score?: number }>,
  ) {
    if (items.length === 0) {
      el.innerHTML = '<li class="bars-empty">no matches</li>';
      return;
    }
    el.innerHTML = '';
    for (const r of items) {
      const m = r.memory;
      const li = document.createElement('li');
      li.className = 'recent-item';
      li.tabIndex = 0;
      li.setAttribute('role', 'button');
      li.innerHTML = `
        <span class="recent-title">${escapeHtml(truncate(m.title, 60))}</span>
        <span class="recent-meta">
          <span class="recent-type">${escapeHtml(m.type)}</span>
          <span class="recent-sep">·</span>
          <span class="recent-project">${escapeHtml(m.project ?? '—')}</span>
          ${r.score !== undefined ? `<span class="recent-sep">·</span><span class="recent-score">${r.score.toFixed(2)}</span>` : ''}
        </span>
      `;
      li.addEventListener('click', () => showDetail(root, m));
      li.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          showDetail(root, m);
        }
      });
      el.appendChild(li);
    }
  }

  function setText(root: HTMLElement, selector: string, text: string) {
    const el = root.querySelector<HTMLElement>(selector);
    if (el) el.textContent = text;
  }

  function truncate(s: string, n: number): string {
    if (s.length <= n) return s;
    return s.slice(0, n - 1) + '…';
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function relativeAge(ms: number): string {
    const diff = Date.now() - ms;
    if (diff < 60_000) return 'just now';
    if (diff < 3_600_000) return `${Math.floor(diff / 60_000)}m ago`;
    if (diff < 86_400_000) return `${Math.floor(diff / 3_600_000)}h ago`;
    if (diff < 2_592_000_000) return `${Math.floor(diff / 86_400_000)}d ago`;
    return new Date(ms).toISOString().slice(0, 10);
  }
</script>

