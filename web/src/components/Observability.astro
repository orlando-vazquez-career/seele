          <li class="bar-row"><span class="bar-key">bugfix</span><span class="bar-track"><span class="bar-fill" style="width:53%"></span></span><span class="bar-count">20</span></li>
          <li class="bar-row"><span class="bar-key">discovery</span><span class="bar-track"><span class="bar-fill" style="width:38%"></span></span><span class="bar-count">14</span></li>
          <li class="bar-row"><span class="bar-key">learning</span><span class="bar-track"><span class="bar-fill" style="width:25%"></span></span><span class="bar-count">9</span></li>
        </ol>
      </section>
      <section class="obs-section">
        <span class="obs-section-eyebrow">// RECENT</span>
        <ol class="recent">
          <li class="recent-item recent-static">
            <span class="recent-title">RRF combiner: weight tuning for hybrid search</span>
            <span class="recent-meta"><span class="recent-type">pattern</span><span class="recent-sep">·</span><span class="recent-project">seele</span><span class="recent-sep">·</span><span class="recent-age">23m ago</span></span>
          </li>
