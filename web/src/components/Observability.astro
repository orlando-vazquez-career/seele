---
/**
 * Observability — live panel that reads from a local SEELE HTTP server
 * (default http://localhost:7777). Renders nothing until /health confirms
 * the server is reachable AND CORS is enabled (response body readable).
 *
 * Sections (rendered in order, every section degrades gracefully if its
 * endpoint fails):
 *   - Stats card: total memories, projects, last save timestamp
 *   - By-type bar chart: top N types from /stats
 *   - Recent saves list: 10 most recent from /memories?limit=10
 *   - Search input: pegs /search and renders matches inline
 *   - Detail panel: click a recent/result entry → full content
 *   - By-project bar chart: counts per project (derived client-side)
 *   - Sparkline saves/day: last 14 days, bucketed client-side
 *
 * Server selection: read from data-endpoint attribute (default
 * http://localhost:7777). User can override via <Observability endpoint="..."/>.
 *
 * CORS contract: SEELE must be started with `seele serve --cors-allow <origin>`.
 * If CORS is disabled, the panel shows an "enable observability" CTA instead
 * of failing silently.
 */

interface Props {
  endpoint?: string;
}

const { endpoint = 'http://localhost:7777' } = Astro.props;
---

<aside class="obs" data-obs data-endpoint={endpoint} data-state="probing" aria-label="SEELE observability">
  <header class="obs-header">
    <span class="obs-eyebrow" data-obs-eyebrow>// OBSERVABILITY</span>
    <span class="obs-dot" aria-hidden="true" data-obs-dot></span>
  </header>

  <!-- Initial probing state -->
  <div class="obs-state obs-state-probing" data-show-when="probing">
    <p class="obs-msg">probing localhost…</p>
  </div>

  <!-- SEELE not detected — show preview sample data so the panel feels alive -->
  <div class="obs-state obs-state-off" data-show-when="offline">
    <div class="preview-banner">
      <span class="preview-label">PREVIEW · sample data</span>
      <p class="preview-note">
        Run <code class="inline-cmd">seele serve</code> locally to see your own memories live here.
      </p>
    </div>
    <div class="obs-preview-grid">
      <section class="obs-section">
        <span class="obs-section-eyebrow">// STATS</span>
        <div class="stats-grid">
          <div class="stat"><span class="stat-label">total</span><span class="stat-value">142</span></div>
          <div class="stat"><span class="stat-label">projects</span><span class="stat-value">4</span></div>
          <div class="stat"><span class="stat-label">last save</span><span class="stat-value">23m</span></div>
