---
interface Props {
  icon: string;
  title: string;
  blurb: string;
  meta: string;
  href: string;
}
const { icon, title, blurb, meta, href } = Astro.props;
---

<a class="feature-card" href={href} rel="noopener" target={href.startsWith('http') ? '_blank' : undefined}>
  <span class="icon" aria-hidden="true">{icon}</span>
  <h3 class="title">{title}</h3>
  <p class="blurb">{blurb}</p>
  <span class="meta">{meta}</span>
  <span class="arrow" aria-hidden="true">→</span>
</a>

<style>
  .feature-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background: var(--semantic-surface-elevated);
    border: 1px solid var(--semantic-border-subtle);
    border-radius: var(--rounded-md);
    text-decoration: none;
    color: var(--semantic-text-primary);
    min-width: 0;
    overflow: hidden;
    transition: border-color var(--duration-base) var(--easing-standard),
      transform var(--duration-fast) var(--easing-standard);
  }

  .feature-card::before {
    /* Subtle gold glow corner on hover */
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 120px;
    height: 120px;
    background: radial-gradient(
      circle at center,
      var(--gold-200) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity var(--duration-base) var(--easing-standard);
    pointer-events: none;
  }

  .feature-card:hover {
    border-color: var(--border-metal);
    transform: translateY(-2px);
  }

  .feature-card:hover::before {
    opacity: 0.18;
  }

  .icon {
    font-size: var(--text-xl);
    color: var(--semantic-text-gold);
    margin-bottom: var(--space-2);
    display: inline-block;
    line-height: 1;
  }

  .title {
    font-size: var(--text-base);
    color: var(--semantic-text-primary);
    margin-bottom: var(--space-1);
  }

  .blurb {
    font-size: var(--text-sm);
    color: var(--semantic-text-secondary);
    line-height: var(--leading-normal);
    flex: 1;
  }

  .meta {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--semantic-text-tertiary);
    overflow-wrap: anywhere;
  }

  .arrow {
    position: absolute;
    top: var(--space-6);
    right: var(--space-6);
    color: var(--semantic-text-tertiary);
    transition: color var(--duration-fast) var(--easing-standard),
      transform var(--duration-fast) var(--easing-standard);
  }

  .feature-card:hover .arrow {
    color: var(--semantic-text-gold);
    transform: translateX(3px);
  }
</style>
