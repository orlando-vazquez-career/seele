---
interface Props {
  num: string;
  title: string;
  blurbEn: string;
  blurbEs: string;
  meta: string;
  href: string;
}
const { num, title, blurbEn, blurbEs, meta, href } = Astro.props;
---

<a class="feature-card" href={href} rel="noopener" target={href.startsWith('http') ? '_blank' : undefined}>
  <span class="num" aria-hidden="true">{num}</span>
  <h3 class="title">{title}</h3>
  <p class="blurb">
    <span lang="en">{blurbEn}</span><span lang="es">{blurbEs}</span>
  </p>
  <pre class="meta"><code>{meta}</code></pre>
  <span class="link"><span lang="en">view →</span><span lang="es">ver →</span></span>
</a>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: var(--border-base) solid var(--semantic-border-base);
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    min-width: 0;
    height: 100%;
  }

  .feature-card:hover {
    background: var(--fg);
    color: var(--bg);
    padding: var(--space-5);
  }

  .feature-card:hover .num,
  .feature-card:hover .title,
  .feature-card:hover .blurb,
  .feature-card:hover .meta,
  .feature-card:hover .link {
    color: var(--bg);
  }

  .feature-card:hover .meta {
    background: var(--bg);
    color: var(--fg);
    border-color: var(--bg);
  }

  .num {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
  }

  .title {
    font-size: var(--text-lg);
    color: var(--fg);
    margin-bottom: var(--space-1);
  }

  .blurb {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--fg-muted);
    flex: 1;
  }

  .meta {
    border: var(--border-hair) solid var(--semantic-border-muted);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg);
    margin: 0;
    background: transparent;
    overflow-x: auto;
    white-space: pre;
  }

  .link {
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    font-weight: var(--weight-bold);
  }
</style>
