---
import Triangle from './Triangle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isObservabilityPage = pathname.endsWith('/observability');

// astro.config.mjs sets `trailingSlash: 'never'` — links must NOT end in /
// `base` is already normalized (trailing slash stripped).
const homeHref = base || '/';
const navItems = isObservabilityPage
  ? [
      { href: homeHref, en: 'home', es: 'inicio' },
      { href: `${homeHref}#features`, en: 'features', es: 'características' },
      { href: `${homeHref}#install`, en: 'install', es: 'instalar' },
      { href: `${homeHref}#support`, en: 'support', es: 'apoyar' },
    ]
  : [
      { href: '#features', en: 'features', es: 'características' },
      { href: '#install', en: 'install', es: 'instalar' },
      { href: '#support', en: 'support', es: 'apoyar' },
      { href: `${base}/observability`, en: 'observability', es: 'observabilidad' },
    ];
---

<header class="site-header">
  <div class="page-container header-inner">
    <a href={homeHref} class="brand" aria-label="SEELE home — a DevZen tool">
      <Triangle size={28} variant="framed" />
      <span class="brand-text">
        <span class="brand-tag">DevZen</span>
        <span class="brand-name">SEELE</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href}>
              <span lang="en">{item.en}</span><span lang="es">{item.es}</span>
            </a>
          </li>
        ))}
        <li>
          <a
            class="nav-github"
            href="https://github.com/orlando-vazquez-career/seele"
            rel="noopener"
            target="_blank"
          >github ↗</a>
        </li>
        <li>
          <button
            type="button"
            class="lang-toggle"
            data-lang-toggle
            aria-label="Toggle Spanish / English"
            title="Toggle Spanish / English"
          >
            <span data-lang-icon>[ EN ]</span>
          </button>
        </li>
        <li>
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-label="Toggle light / dark mode"
            title="Toggle light / dark mode"
          >
            <span data-theme-icon>[ ◐ ]</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  // Inline script: runs before page paint to avoid theme/lang flash.
  (function () {
    // Theme: localStorage 'seele-theme' → prefers-color-scheme → dark
    function resolveTheme() {
      try {
        const saved = localStorage.getItem('seele-theme');
        if (saved === 'light' || saved === 'dark') return saved;
      } catch (_) { /* private mode */ }
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
        return 'light';
      }
      return 'dark';
    }
    // Lang: localStorage 'seele-lang' → navigator.language → en
    function resolveLang() {
      try {
        const saved = localStorage.getItem('seele-lang');
        if (saved === 'en' || saved === 'es') return saved;
      } catch (_) { /* private mode */ }
      var nav = (navigator.language || '').toLowerCase();
      if (nav.indexOf('es') === 0) return 'es';
      return 'en';
    }
    document.documentElement.setAttribute('data-theme', resolveTheme());
    document.documentElement.setAttribute('lang', resolveLang());
  })();
</script>

<script>
  // ───────── Theme toggle ─────────
  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    try { localStorage.setItem('seele-theme', theme); } catch (_) {}
    updateThemeIcons(theme);
  }
  function updateThemeIcons(theme: 'light' | 'dark') {
    document.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((el) => {
      el.textContent = theme === 'light' ? '[ ◑ ]' : '[ ◐ ]';
    });
  }
  function currentTheme(): 'light' | 'dark' {
    return (document.documentElement.getAttribute('data-theme') as 'light' | 'dark') || 'dark';
  }
  updateThemeIcons(currentTheme());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      applyTheme(currentTheme() === 'light' ? 'dark' : 'light');
    });
  });

  // ───────── Lang toggle ─────────
  function applyLang(lang: 'en' | 'es') {
    document.documentElement.setAttribute('lang', lang);
    try { localStorage.setItem('seele-lang', lang); } catch (_) {}
    updateLangIcons(lang);
    updatePlaceholders(lang);
  }
  function updatePlaceholders(lang: 'en' | 'es') {
    document.querySelectorAll<HTMLInputElement>('[data-placeholder-en][data-placeholder-es]').forEach((el) => {
      const next = lang === 'es' ? el.dataset.placeholderEs : el.dataset.placeholderEn;
      if (next) el.placeholder = next;
    });
  }
  function updateLangIcons(lang: 'en' | 'es') {
    // Icon shows the OTHER language — the one a click will switch TO.
    const next = lang === 'en' ? 'ES' : 'EN';
    document.querySelectorAll<HTMLElement>('[data-lang-icon]').forEach((el) => {
      el.textContent = `[ ${next} ]`;
    });
  }
  function currentLang(): 'en' | 'es' {
    return (document.documentElement.getAttribute('lang') as 'en' | 'es') || 'en';
  }
  updateLangIcons(currentLang());
  updatePlaceholders(currentLang());
  document.querySelectorAll<HTMLButtonElement>('[data-lang-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      applyLang(currentLang() === 'en' ? 'es' : 'en');
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--bg);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--semantic-text-primary);
    text-decoration: none;
    line-height: 1;
  }

  .brand:hover {
    background: transparent;
    padding: 0;
  }

  .brand:hover :global(.triangle) {
    color: var(--accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-tag {
    font-size: 9px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .brand-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    letter-spacing: 0.04em;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    color: var(--semantic-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
  }

  .nav-list a:hover {
    color: var(--bg);
    background: var(--accent);
    padding: 2px 4px;
  }

  .nav-github {
    color: var(--semantic-text-primary) !important;
  }

  .theme-toggle,
  .lang-toggle {
    background: transparent;
    border: var(--border-hair) solid var(--semantic-border-muted);
    color: var(--fg-muted);
    padding: 4px var(--space-2);
    font-family: inherit;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    cursor: pointer;
  }

  .theme-toggle:hover,
  .lang-toggle:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .nav-list li:nth-child(-n+2),
    .nav-list li:nth-child(3) {
      /* keep on mobile: only nav-github + theme-toggle (last two children) */
      display: none;
    }
    .nav-list {
      gap: var(--space-3);
    }
    .brand-text {
      display: none;
    }
  }
</style>
