---
import Triangle from './Triangle.astro';

const base = import.meta.env.BASE_URL;
const navItems = [
  { href: '#features', label: 'features' },
  { href: '#install', label: 'install' },
  { href: '#support', label: 'support' },
];
---

<header class="site-header">
  <div class="page-container header-inner">
    <a href={base} class="brand" aria-label="SEELE home — a DevZen tool">
      <Triangle size={24} variant="framed" />
      <span class="brand-text">
        <span class="brand-tag">DevZen</span>
        <span class="brand-name">SEELE</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li>
          <a
            class="nav-github"
            href="https://github.com/orlando-vazquez-career/seele"
            rel="noopener"
            target="_blank"
          >github ↗</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--bg);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--semantic-text-primary);
    text-decoration: none;
    line-height: 1;
  }

  .brand:hover {
    background: transparent;
    padding: 0;
  }

  .brand:hover :global(.triangle) {
    color: var(--accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-tag {
    font-size: 9px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .brand-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    letter-spacing: 0.04em;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    color: var(--semantic-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
  }

  .nav-list a:hover {
    color: var(--bg);
    background: var(--accent);
    padding: 2px 4px;
  }

  .nav-github {
    color: var(--semantic-text-primary) !important;
  }

  @media (max-width: 640px) {
    .nav-list li:not(:last-child) {
      display: none;
    }
    .nav-list {
      gap: var(--space-3);
    }
    .brand-text {
      display: none;
    }
  }
</style>
