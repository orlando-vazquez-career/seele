---
import Triangle from './Triangle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isObservabilityPage = pathname.endsWith('/observability');

// astro.config.mjs sets `trailingSlash: 'never'` — links must NOT end in /
// `base` is already normalized (trailing slash stripped).
const homeHref = base || '/';
const navItems = isObservabilityPage
  ? [
      { href: homeHref, label: 'home' },
      { href: `${homeHref}#features`, label: 'features' },
      { href: `${homeHref}#install`, label: 'install' },
      { href: `${homeHref}#support`, label: 'support' },
    ]
  : [
      { href: '#features', label: 'features' },
      { href: '#install', label: 'install' },
      { href: '#support', label: 'support' },
      { href: `${base}/observability`, label: 'observability' },
    ];
---

<header class="site-header">
  <div class="page-container header-inner">
    <a href={homeHref} class="brand" aria-label="SEELE home — a DevZen tool">
      <Triangle size={28} variant="framed" />
      <span class="brand-text">
        <span class="brand-tag">DevZen</span>
        <span class="brand-name">SEELE</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li>
          <a
            class="nav-github"
            href="https://github.com/orlando-vazquez-career/seele"
            rel="noopener"
            target="_blank"
          >github ↗</a>
        </li>
        <li>
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-label="Toggle light / dark mode"
            title="Toggle light / dark mode"
          >
            <span data-theme-icon>[ ◐ ]</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  // Inline script: runs before page paint to avoid theme flash.
  // Resolution order:
  //   1. localStorage 'seele-theme' = 'light' | 'dark' (explicit user choice)
  //   2. system preference via matchMedia
  //   3. default dark
  (function () {
    const STORAGE_KEY = 'seele-theme';
    function resolveTheme() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved === 'light' || saved === 'dark') return saved;
      } catch (_) { /* private mode */ }
      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
        return 'light';
      }
      return 'dark';
    }
    const theme = resolveTheme();
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>

<script>
  // Toggle handler — runs after DOMContentLoaded
  const STORAGE_KEY = 'seele-theme';

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch (_) { /* private mode */ }
    updateIcons(theme);
  }

  function updateIcons(theme: 'light' | 'dark') {
    document.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((el) => {
      el.textContent = theme === 'light' ? '[ ◑ ]' : '[ ◐ ]';
    });
  }

  function currentTheme(): 'light' | 'dark' {
    return (document.documentElement.getAttribute('data-theme') as 'light' | 'dark') || 'dark';
  }

  // Initialize icon on load
  updateIcons(currentTheme());

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = currentTheme() === 'light' ? 'dark' : 'light';
      applyTheme(next);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: var(--bg);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--semantic-text-primary);
    text-decoration: none;
    line-height: 1;
  }

  .brand:hover {
    background: transparent;
    padding: 0;
  }

  .brand:hover :global(.triangle) {
    color: var(--accent);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-tag {
    font-size: 9px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .brand-name {
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    letter-spacing: 0.04em;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    color: var(--semantic-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
  }

  .nav-list a:hover {
    color: var(--bg);
    background: var(--accent);
    padding: 2px 4px;
  }

  .nav-github {
    color: var(--semantic-text-primary) !important;
  }

  .theme-toggle {
    background: transparent;
    border: var(--border-hair) solid var(--semantic-border-muted);
    color: var(--fg-muted);
    padding: 4px var(--space-2);
    font-family: inherit;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .nav-list li:nth-child(-n+2),
    .nav-list li:nth-child(3) {
      /* keep on mobile: only nav-github + theme-toggle (last two children) */
      display: none;
    }
    .nav-list {
      gap: var(--space-3);
    }
    .brand-text {
      display: none;
    }
  }
</style>
