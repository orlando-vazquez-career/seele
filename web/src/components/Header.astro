---
import Triangle from './Triangle.astro';

const base = import.meta.env.BASE_URL;
const navItems = [
  { href: '#features', label: 'Features' },
  { href: '#install', label: 'Install' },
  { href: '#support', label: 'Support' },
];
---

<header class="site-header">
  <div class="page-container header-inner">
    <a href={base} class="brand" aria-label="SEELE home — a DevZen tool">
      <Triangle variant="outline" size={28} opacity={1} />
      <span class="brand-text">
        <span class="brand-tag silver-text">DevZen</span>
        <span class="brand-name">SEELE</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li>
          <a
            class="nav-github"
            href="https://github.com/orlando-vazquez-career/seele"
            rel="noopener"
            target="_blank"
          >
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: oklch(0.10 0.003 230 / 0.85);
    backdrop-filter: blur(12px) saturate(120%);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    border-bottom: 1px solid var(--semantic-border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--semantic-text-primary);
    text-decoration: none;
    line-height: 1;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .brand-tag {
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-wide);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    color: var(--semantic-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--duration-fast) var(--easing-standard);
  }

  .nav-list a:hover {
    color: var(--semantic-text-primary);
  }

  .nav-github {
    color: var(--semantic-text-primary) !important;
  }

  @container (max-width: 640px) {
    .nav-list li:not(:last-child) {
      display: none;
    }
  }

  /* Container query at the page-container level */
  @media (max-width: 640px) {
    .nav-list li:not(:last-child) {
      display: none;
    }
    .nav-list {
      gap: var(--space-3);
    }
  }
</style>
