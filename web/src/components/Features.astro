---
import FeatureCard from './FeatureCard.astro';

const features = [
  {
    num: '// 01',
    title: 'CLI',
    blurbEn: '17 subcommands. save · search · link · sync · doctor · projects · setup. Local SQLite, zero network.',
    blurbEs: '17 subcomandos. save · search · link · sync · doctor · projects · setup. SQLite local, cero red.',
    meta: 'seele save / search / list ...',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
  {
    num: '// 02',
    title: 'MCP',
    blurbEn: '19 tools under seele_* namespace. Drops into Claude Code, Cursor, Windsurf with one command.',
    blurbEs: '19 tools bajo namespace seele_*. Se enchufa a Claude Code, Cursor, Windsurf con un comando.',
    meta: 'seele setup --agent claude-code',
    href: 'https://github.com/orlando-vazquez-career/seele/blob/main/docs/AGENT-SETUP.md',
  },
  {
    num: '// 03',
    title: 'HTTP',
    blurbEn: '18 paths + OpenAPI 3.1 + Swagger UI at /docs. Bearer auth, optional legacy ENGRAM aliases.',
    blurbEs: '18 paths + OpenAPI 3.1 + Swagger UI en /docs. Auth Bearer, aliases ENGRAM legacy opcionales.',
    meta: 'seele serve --port 7777',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
  {
    num: '// 04',
    title: 'TUI',
    blurbEn: 'Ratatui interface. 5 panes (Home, Browse, Search, Detail, Stats). Vi-style keymap.',
    blurbEs: 'Interfaz Ratatui. 5 paneles (Home, Browse, Search, Detail, Stats). Keymap estilo Vi.',
    meta: 'seele tui',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
];
---

<section id="features" class="features">
  <div class="page-container features-inner">
    <header class="features-header">
      <span class="features-eyebrow"><span lang="en">// FEATURES</span><span lang="es">// CARACTERÍSTICAS</span></span>
      <h2 class="features-heading">
        <span lang="en">One binary.<br />Four interfaces.</span><span lang="es">Un binario.<br />Cuatro interfaces.</span>
      </h2>
      <p class="features-lead">
        <span lang="en">Pick the one your agent prefers — they all speak to the same local SQLite.</span><span lang="es">Elegí la que tu agente prefiera — todas hablan con la misma SQLite local.</span>
      </p>
    </header>

    <div class="features-grid">
      {features.map((f) => (
        <FeatureCard num={f.num} title={f.title} blurbEn={f.blurbEn} blurbEs={f.blurbEs} meta={f.meta} href={f.href} />
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--space-20);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .features-header {
    margin-bottom: var(--space-10);
    max-width: 60ch;
  }

  .features-eyebrow {
    display: block;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .features-heading {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin-bottom: var(--space-5);
  }

  .features-lead {
    font-size: var(--text-base);
    color: var(--fg-muted);
    line-height: var(--leading-relaxed);
  }

  .features-grid {
    display: grid;
    /* Asymmetric tile ratios: 30% / 25% / 25% / 20% — CLI dominates */
    grid-template-columns: 1.5fr 1.25fr 1.25fr 1fr;
    gap: var(--space-3);
  }

  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
