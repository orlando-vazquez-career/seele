---
import FeatureCard from './FeatureCard.astro';

const features = [
  {
    icon: '⌨',
    title: 'CLI',
    blurb: '17 subcommands. Save, search, link, sync, doctor, projects, setup. Local SQLite, zero network.',
    meta: 'seele save / search / show / list / link / sync …',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
  {
    icon: '◉',
    title: 'MCP',
    blurb: '19 tools under seele_* namespace. Drops into Claude Code, Cursor, Windsurf with one command.',
    meta: 'seele setup --agent claude-code',
    href: 'https://github.com/orlando-vazquez-career/seele/blob/main/docs/AGENT-SETUP.md',
  },
  {
    icon: '↗',
    title: 'HTTP',
    blurb: '18 paths + OpenAPI 3.1 + Swagger UI at /docs. Bearer auth, optional legacy ENGRAM aliases.',
    meta: 'seele serve --port 7777',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
  {
    icon: '▦',
    title: 'TUI',
    blurb: 'Ratatui interface. 5 panes (Home, Browse, Search, Detail, Stats). Vi-style keymap.',
    meta: 'seele tui',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
];
---

<section id="features" class="features">
  <div class="page-container features-inner">
    <p class="features-eyebrow silver-text">/ Features</p>
    <h2 class="features-heading">
      One binary, <span class="gold-text">four interfaces</span>
    </h2>
    <p class="features-lead">
      Pick the one your agent prefers — they all speak to the same local SQLite.
    </p>
    <div class="features-grid">
      {features.map((f) => (
        <FeatureCard {...f} />
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: clamp(var(--space-16), 8vw, var(--space-20));
    border-top: 1px solid var(--semantic-border-subtle);
  }

  .features-inner {
    container-type: inline-size;
  }

  .features-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .features-heading {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }

  .features-lead {
    font-size: var(--text-base);
    color: var(--semantic-text-secondary);
    margin-bottom: var(--space-10);
    max-width: 560px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-4);
  }

  @container (min-width: 920px) {
    .features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
