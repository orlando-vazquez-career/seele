---
import FeatureCard from './FeatureCard.astro';

const features = [
  {
    num: '// 01',
    title: 'CLI',
    blurb: '17 subcommands. save · search · link · sync · doctor · projects · setup. Local SQLite, zero network.',
    meta: 'seele save / search / list ...',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
  {
    num: '// 02',
    title: 'MCP',
    blurb: '19 tools under seele_* namespace. Drops into Claude Code, Cursor, Windsurf with one command.',
    meta: 'seele setup --agent claude-code',
    href: 'https://github.com/orlando-vazquez-career/seele/blob/main/docs/AGENT-SETUP.md',
  },
  {
    num: '// 03',
    title: 'HTTP',
    blurb: '18 paths + OpenAPI 3.1 + Swagger UI at /docs. Bearer auth, optional legacy ENGRAM aliases.',
    meta: 'seele serve --port 7777',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
  {
    num: '// 04',
    title: 'TUI',
    blurb: 'Ratatui interface. 5 panes (Home, Browse, Search, Detail, Stats). Vi-style keymap.',
    meta: 'seele tui',
    href: 'https://github.com/orlando-vazquez-career/seele#what-you-get',
  },
];
---

<section id="features" class="features">
  <div class="page-container features-inner">
    <header class="features-header">
      <span class="features-eyebrow">// FEATURES</span>
      <h2 class="features-heading">
        One binary.<br />
        Four interfaces.
      </h2>
      <p class="features-lead">
        Pick the one your agent prefers — they all speak to the same local SQLite.
      </p>
    </header>

    <div class="features-grid">
      {features.map((f) => (
        <FeatureCard {...f} />
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--space-20);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .features-header {
    margin-bottom: var(--space-10);
    max-width: 60ch;
  }

  .features-eyebrow {
    display: block;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .features-heading {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin-bottom: var(--space-5);
  }

  .features-lead {
    font-size: var(--text-base);
    color: var(--fg-muted);
    line-height: var(--leading-relaxed);
  }

  .features-grid {
    display: grid;
    /* Asymmetric tile ratios: 30% / 25% / 25% / 20% — CLI dominates */
    grid-template-columns: 1.5fr 1.25fr 1.25fr 1fr;
    gap: var(--space-3);
  }

  @media (max-width: 960px) {
    .features-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
