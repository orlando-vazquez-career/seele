---
import Triangle from './Triangle.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page-container footer-inner">
    <div class="footer-top">
      <a
        href="https://github.com/orlando-vazquez-career/seele"
        rel="noopener"
        target="_blank"
        class="devzen-mark"
        aria-label="DevZen SpA — SEELE project"
      >
        <Triangle variant="outline" size={36} opacity={0.9} />
        <span class="devzen-text">
          <span class="devzen-tag silver-text">a</span>
          <span class="devzen-name gold-text">DevZen</span>
          <span class="devzen-tag silver-text">tool</span>
        </span>
      </a>
      <p class="legal">
        © {year} DevZen SpA · <a
          href="https://github.com/orlando-vazquez-career/seele/blob/main/LICENSE"
          rel="noopener"
          target="_blank"
        >MIT licensed</a>
      </p>
    </div>

    <div class="footer-links">
      <a
        href="https://github.com/orlando-vazquez-career/seele/blob/main/CHANGELOG.md"
        rel="noopener"
        target="_blank"
      >Changelog</a>
      <span class="sep" aria-hidden="true">·</span>
      <a
        href="https://github.com/orlando-vazquez-career/seele/discussions"
        rel="noopener"
        target="_blank"
      >Discussions</a>
      <span class="sep" aria-hidden="true">·</span>
      <a
        href="https://github.com/Gentleman-Programming/engram"
        rel="noopener"
        target="_blank"
      >Inspired by ENGRAM</a>
      <span class="sep" aria-hidden="true">·</span>
      <a
        href="https://github.com/orlando-vazquez-career/seele"
        rel="noopener"
        target="_blank"
      >GitHub ↗</a>
    </div>

    <p class="disclosure">
      No tracking · no analytics · no cookies · no SDKs. <br />
      <em>Super stellatum firmamentum iudicat Deus, sicut nos iudicamus.</em>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-10) var(--space-12);
    border-top: 1px solid var(--semantic-border-subtle);
    background:
      radial-gradient(
        ellipse 60% 40% at 50% 100%,
        oklch(0.08 0.002 230) 0%,
        oklch(0.06 0 0) 100%
      );
  }

  .footer-inner {
    container-type: inline-size;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .devzen-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .devzen-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1;
  }

  .devzen-tag {
    font-family: var(--font-display);
    font-size: 9px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
  }

  .devzen-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-wide);
  }

  .legal {
    font-size: var(--text-xs);
    color: var(--semantic-text-tertiary);
  }

  .legal a {
    color: var(--semantic-text-secondary);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--text-xs);
  }

  .footer-links a {
    color: var(--semantic-text-secondary);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--semantic-text-gold);
  }

  .sep {
    color: var(--semantic-text-quaternary);
  }

  .disclosure {
    font-size: var(--text-xs);
    color: var(--semantic-text-tertiary);
    line-height: var(--leading-relaxed);
    max-width: 640px;
  }

  .disclosure em {
    color: var(--semantic-text-secondary);
    font-style: italic;
    font-family: var(--font-display);
  }
</style>
