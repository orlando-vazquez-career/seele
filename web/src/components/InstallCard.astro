---
interface Props {
  num: string;
  title: string;
  description: string;
  command: string;
  recommended?: boolean;
  notes?: string;
}
const { num, title, description, command, recommended = false, notes } = Astro.props;
---

<article class={`install-card${recommended ? ' is-recommended' : ''}`}>
  <header class="install-header">
    <span class="num">{num}</span>
    {recommended && <span class="badge">RECOMENDADO</span>}
  </header>
  <h3 class="title">{title}</h3>
  <p class="description">{description}</p>
  <div class="cmd-wrap">
    <pre class="cmd"><code>$ {command}</code></pre>
    <button
      class="copy-btn"
      type="button"
      data-copy={command}
      aria-label={`Copy ${title} command`}
    >
      COPY
    </button>
  </div>
  {notes && <p class="notes">{notes}</p>}
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.dataset.copy;
      if (!cmd) return;
      try {
        await navigator.clipboard.writeText(cmd);
        const original = btn.textContent;
        btn.textContent = 'COPIED';
        btn.classList.add('is-copied');
        window.setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('is-copied');
        }, 1500);
      } catch { /* silent fail */ }
    });
  });
</script>

<style>
  .install-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: var(--border-base) solid var(--semantic-border-base);
    background: var(--bg);
    min-width: 0;
  }

  .install-card.is-recommended {
    border-color: var(--accent);
  }

  .install-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .num {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
  }

  .badge {
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    background: var(--accent);
    color: var(--bg);
    padding: 2px var(--space-2);
  }

  .title {
    font-size: var(--text-lg);
    color: var(--fg);
  }

  .description {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: var(--leading-relaxed);
  }

  .cmd-wrap {
    position: relative;
    display: flex;
    min-width: 0;
  }

  .cmd {
    flex: 1;
    margin: 0;
    padding: var(--space-3) var(--space-10) var(--space-3) var(--space-3);
    background: transparent;
    border: var(--border-hair) solid var(--semantic-border-muted);
    font-size: var(--text-xs);
    color: var(--fg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: normal;
    min-width: 0;
  }

  .copy-btn {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: var(--space-1) var(--space-2);
    background: transparent;
    color: var(--fg-muted);
    border: var(--border-hair) solid var(--semantic-border-muted);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    cursor: pointer;
  }

  .copy-btn:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .copy-btn.is-copied {
    background: var(--success);
    color: var(--bg);
    border-color: var(--success);
  }

  .notes {
    font-size: var(--text-xs);
    color: var(--fg-faint);
    line-height: var(--leading-relaxed);
    overflow-wrap: anywhere;
  }
</style>
