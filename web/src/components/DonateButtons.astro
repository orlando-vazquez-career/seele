---
/**
 * DonateButtons — donate widget with REAL wallet integration.
 *
 *   - EVM (ETH / Base / Syscoin NEVM): EIP-6963 discovery → EIP-1193
 *     window.ethereum.request opens MetaMask/Pali popup with destination
 *     pre-filled. Chain switching via wallet_switchEthereumChain with
 *     wallet_addEthereumChain fallback for Base + Syscoin.
 *   - Solana: solana: URI — Phantom desktop extension parses these natively.
 *   - Bitcoin: BIP-21 URI — Sparrow/Electrum/Trezor Suite register OS handler.
 *
 * All five share a fallback: if no handler/wallet → copy address + open
 * the official extension install page.
 */

const targets = [
  {
    id: 'btc',
    label: 'Bitcoin',
    glyph: '$',
    address: 'bc1qzznr7lwzeyp738079k34yserkzketyju9k7kte',
    method: 'bip21',
    uri: 'bitcoin:bc1qzznr7lwzeyp738079k34yserkzketyju9k7kte?label=SEELE',
    install: 'https://sparrowwallet.com/download/',
    walletName: 'Sparrow / Electrum',
    chainId: null,
  },
  {
    id: 'eth',
    label: 'Ethereum',
    glyph: 'E',
    address: '0x0f47273B14118EDD15b40A5CfDBFc4A7891F08D8',
    method: 'evm',
    uri: null,
    install: 'https://chromewebstore.google.com/detail/metamask/nkbihfbeogaeaoehlefnkodbefgpgknn',
    walletName: 'MetaMask',
    chainId: 1,
  },
  {
    id: 'base',
    label: 'Base',
    glyph: 'B',
    address: '0x0f47273B14118EDD15b40A5CfDBFc4A7891F08D8',
    method: 'evm',
    uri: null,
    install: 'https://chromewebstore.google.com/detail/metamask/nkbihfbeogaeaoehlefnkodbefgpgknn',
    walletName: 'MetaMask',
    chainId: 8453,
  },
  {
    id: 'sys',
    label: 'Syscoin',
    glyph: 'Y',
    address: '0x0f47273B14118EDD15b40A5CfDBFc4A7891F08D8',
    method: 'evm',
    uri: null,
    install: 'https://chromewebstore.google.com/detail/pali-wallet/mgffkfbidihjpoaomajlbgchddlicgpn',
    walletName: 'Pali',
    chainId: 57,
  },
  {
    id: 'sol',
    label: 'Solana',
    glyph: 'S',
    address: 'Ecz5kPxCx3oaX64kmos6wzCpswA5LwDqttp2Y1HrQQ7K',
    method: 'solana-pay',
    uri: 'solana:Ecz5kPxCx3oaX64kmos6wzCpswA5LwDqttp2Y1HrQQ7K?label=SEELE',
    install: 'https://chromewebstore.google.com/detail/phantom/bfnaelmomeimhlpmgjnjophhpkkoljpa',
    walletName: 'Phantom',
    chainId: null,
  },
];
---

<div class="donate-wrapper">
  <div class="donate-detect" data-detect data-state="scanning">
    <span class="detect-dot" aria-hidden="true"></span>
    <span class="detect-label" data-detect-label>scanning for wallet extensions…</span>
  </div>

  <div class="donate-grid" role="group" aria-label="Donate to SEELE">
    {targets.map((t) => (
      <button
        type="button"
        class="donate-btn"
        data-id={t.id}
        data-method={t.method}
        data-uri={t.uri ?? ''}
        data-address={t.address}
        data-chain-id={t.chainId ?? ''}
        data-install={t.install}
        data-wallet-name={t.walletName}
        aria-label={`Donate ${t.label}: opens ${t.walletName} with address ${t.address} pre-filled`}
      >
        <span class="num">// 0{targets.indexOf(t) + 1}</span>
        <span class="name">{t.label}</span>
        <span class="addr">{t.address.slice(0, 6)}…{t.address.slice(-4)}</span>
        <span class="wallet-tag" data-wallet-tag>{t.walletName}</span>
        <span class="status" data-status></span>
      </button>
    ))}
  </div>
</div>

<script>
  type ProviderInfo = { uuid: string; name: string; icon: string; rdns: string };
  type EvmProvider = {
    request: (args: { method: string; params?: unknown[] | object }) => Promise<unknown>;
    isMetaMask?: boolean;
  };
  type ProviderEntry = { info: ProviderInfo; provider: EvmProvider };

  const providers = new Map<string, ProviderEntry>();

  window.addEventListener('eip6963:announceProvider' as never, (event: Event) => {
    const detail = (event as CustomEvent<ProviderEntry>).detail;
    if (detail?.info?.rdns) providers.set(detail.info.rdns, detail);
  });
  window.dispatchEvent(new Event('eip6963:requestProvider'));

  function pickEvmProvider(): EvmProvider | null {
    const preferred = ['io.metamask', 'io.metamask.flask', 'io.pali', 'io.paliwallet', 'app.phantom'];
    for (const rdns of preferred) {
      if (providers.has(rdns)) return providers.get(rdns)!.provider;
    }
    if (providers.size > 0) return providers.values().next().value!.provider;
    const legacy = (window as unknown as { ethereum?: EvmProvider }).ethereum;
    return legacy ?? null;
  }

  function getDetectedWalletNames(): string[] {
    const names: string[] = [];
    for (const { info } of providers.values()) names.push(info.name);
    if (names.length === 0) {
      const legacy = (window as unknown as { ethereum?: { isMetaMask?: boolean; isPali?: boolean } }).ethereum;
      if (legacy?.isMetaMask) names.push('MetaMask');
      else if (legacy?.isPali) names.push('Pali');
      else if (legacy) names.push('Wallet');
    }
    return names;
  }

  function hasSolanaProvider(): boolean {
    const w = window as unknown as { phantom?: { solana?: unknown }; solana?: unknown };
    return Boolean(w.phantom?.solana || w.solana);
  }

  const CHAINS: Record<number, { hex: string; add?: object }> = {
    1: { hex: '0x1' },
    8453: {
      hex: '0x2105',
      add: {
        chainId: '0x2105',
        chainName: 'Base',
        nativeCurrency: { name: 'Ether', symbol: 'ETH', decimals: 18 },
        rpcUrls: ['https://mainnet.base.org'],
        blockExplorerUrls: ['https://basescan.org'],
      },
    },
    57: {
      hex: '0x39',
      add: {
        chainId: '0x39',
        chainName: 'Syscoin NEVM',
        nativeCurrency: { name: 'Syscoin', symbol: 'SYS', decimals: 18 },
        rpcUrls: ['https://rpc.syscoin.org/'],
        blockExplorerUrls: ['https://explorer.syscoin.org/'],
      },
    },
  };

  async function ensureChain(provider: EvmProvider, chainId: number) {
    const cfg = CHAINS[chainId];
    if (!cfg) throw new Error(`Unsupported chain ${chainId}`);
    try {
      await provider.request({
        method: 'wallet_switchEthereumChain',
        params: [{ chainId: cfg.hex }],
      });
    } catch (err: unknown) {
      const code = (err as { code?: number }).code;
      if (code === 4902 && cfg.add) {
        await provider.request({
          method: 'wallet_addEthereumChain',
          params: [cfg.add],
        });
      } else {
        throw err;
      }
    }
  }

  async function copyToClipboard(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  async function handleClick(btn: HTMLButtonElement) {
    const id = btn.dataset.id!;
    const method = btn.dataset.method!;
    const uri = btn.dataset.uri || '';
    const address = btn.dataset.address!;
    const chainId = btn.dataset.chainId ? parseInt(btn.dataset.chainId, 10) : null;
    const install = btn.dataset.install!;
    const statusEl = btn.querySelector<HTMLElement>('[data-status]');

    const setStatus = (text: string, state = '') => {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.dataset.state = state;
    };
    const clearStatusAfter = (ms: number) => {
      window.setTimeout(() => setStatus('', ''), ms);
    };

    if (method === 'evm') {
      const provider = pickEvmProvider();
      if (!provider) {
        setStatus('INSTALL →', 'install');
        window.open(install, '_blank', 'noopener');
        await copyToClipboard(address);
        clearStatusAfter(3500);
        return;
      }
      setStatus('OPENING…', 'opening');
      try {
        const accounts = (await provider.request({
          method: 'eth_requestAccounts',
        })) as string[];
        const from = accounts[0];
        if (!from) throw new Error('No account');
        if (chainId !== null) {
          await ensureChain(provider, chainId);
        }
        const txHash = (await provider.request({
          method: 'eth_sendTransaction',
          params: [{ from, to: address, value: '0x0' }],
        })) as string;
        setStatus('SENT', 'sent');
        console.info(`[${id}] tx sent:`, txHash);
        clearStatusAfter(4000);
      } catch (err: unknown) {
        const code = (err as { code?: number }).code;
        if (code === 4001) {
          setStatus('REJECTED', 'rejected');
        } else if (code === -32002) {
          setStatus('CHECK WALLET', 'pending');
        } else {
          setStatus('ERROR', 'error');
          console.error(`[${id}] error:`, err);
        }
        clearStatusAfter(3000);
      }
      return;
    }

    if (method === 'solana-pay') {
      const hasPhantom = hasSolanaProvider();
      if (!hasPhantom) {
        setStatus('INSTALL →', 'install');
        window.open(install, '_blank', 'noopener');
        await copyToClipboard(address);
        clearStatusAfter(3500);
        return;
      }
      setStatus('OPENING…', 'opening');
      window.location.href = uri;
      window.setTimeout(async () => {
        if (!document.hidden) {
          await copyToClipboard(address);
          setStatus('COPIED', 'copied');
          clearStatusAfter(2000);
        } else {
          setStatus('', '');
        }
      }, 700);
      return;
    }

    if (method === 'bip21') {
      setStatus('OPENING…', 'opening');
      window.location.href = uri;
      window.setTimeout(async () => {
        if (!document.hidden) {
          await copyToClipboard(address);
          setStatus('COPIED', 'copied');
          clearStatusAfter(2000);
        } else {
          setStatus('', '');
        }
      }, 700);
      return;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.donate-btn').forEach((btn) => {
    btn.addEventListener('click', () => handleClick(btn));
  });

  function updateDetect() {
    const banner = document.querySelector<HTMLElement>('[data-detect]');
    const label = document.querySelector<HTMLElement>('[data-detect-label]');
    if (!banner || !label) return;
    const evmWallets = getDetectedWalletNames();
    const sol = hasSolanaProvider();
    const detected: string[] = [];
    if (evmWallets.length) detected.push(...evmWallets);
    if (sol) detected.push('Phantom');
    if (detected.length > 0) {
      banner.dataset.state = 'detected';
      label.textContent = `wallets detected: ${detected.join(' · ')}`;
    } else {
      banner.dataset.state = 'none';
      label.textContent = 'no wallet extension detected — click opens install page';
    }
    document.querySelectorAll<HTMLButtonElement>('.donate-btn').forEach((btn) => {
      const method = btn.dataset.method;
      const tagEl = btn.querySelector<HTMLElement>('[data-wallet-tag]');
      if (!tagEl) return;
      const isAvailable =
        (method === 'evm' && evmWallets.length > 0) ||
        (method === 'solana-pay' && sol) ||
        method === 'bip21';
      tagEl.dataset.available = isAvailable ? 'yes' : 'no';
    });
  }

  window.setTimeout(updateDetect, 200);
  window.addEventListener('eip6963:announceProvider' as never, () => updateDetect());
</script>

<style>
  .donate-wrapper {
    container-type: inline-size;
  }

  .donate-detect {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    margin-bottom: var(--space-5);
    border: var(--border-base) solid var(--semantic-border-muted);
    border-radius: var(--rounded-pill);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .detect-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--rounded-pill);
    background: var(--fg-muted);
  }

  .donate-detect[data-state='scanning'] .detect-dot {
    animation: pulse 1.4s ease-in-out infinite;
  }

  .donate-detect[data-state='detected'] {
    border-color: var(--semantic-status-wallet-detected);
  }
  .donate-detect[data-state='detected'] .detect-dot {
    background: var(--semantic-status-wallet-detected);
  }
  .donate-detect[data-state='detected'] .detect-label {
    color: var(--fg);
  }

  .donate-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: var(--space-3);
  }

  .donate-btn {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      'num    status'
      'name   name'
      'addr   wallet';
    gap: var(--space-1) var(--space-3);
    padding: var(--space-4);
    background: var(--bg);
    color: var(--fg);
    border: var(--border-base) solid var(--semantic-border-base);
    cursor: pointer;
    text-align: left;
    min-width: 0;
    font-family: inherit;
  }

  .donate-btn:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .donate-btn:hover .num,
  .donate-btn:hover .name,
  .donate-btn:hover .addr,
  .donate-btn:hover .wallet-tag,
  .donate-btn:hover .status {
    color: var(--bg);
  }

  .num {
    grid-area: num;
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    color: var(--accent);
  }

  .name {
    grid-area: name;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--fg);
  }

  .addr {
    grid-area: addr;
    font-size: var(--text-xs);
    color: var(--fg-faint);
    letter-spacing: var(--tracking-wide);
  }

  .wallet-tag {
    grid-area: wallet;
    font-size: 10px;
    color: var(--fg-faint);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-align: right;
  }

  .wallet-tag[data-available='yes'] {
    color: var(--semantic-status-wallet-detected);
  }

  .status {
    grid-area: status;
    font-size: 10px;
    color: var(--fg-faint);
    letter-spacing: var(--tracking-caps);
    text-align: right;
    min-height: 1em;
  }

  .status[data-state='opening']  { color: var(--accent); }
  .status[data-state='copied']   { color: var(--success); }
  .status[data-state='sent']     { color: var(--success); }
  .status[data-state='rejected'] { color: var(--danger); }
  .status[data-state='pending']  { color: var(--warning); }
  .status[data-state='error']    { color: var(--danger); }
  .status[data-state='install']  { color: var(--accent); }

  @keyframes pulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
</style>
