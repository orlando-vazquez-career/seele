---
import InstallCard from './InstallCard.astro';

const installPaths = [
  {
    num: '// 01',
    title: 'install script',
    description: 'SHA256-verified pre-built binary. Linux, macOS, Windows.',
    command:
      'curl -fsSL https://raw.githubusercontent.com/orlando-vazquez-career/seele/main/scripts/install.sh | bash',
    recommended: true,
    notes: 'Windows: irm https://raw.githubusercontent.com/orlando-vazquez-career/seele/main/scripts/install.ps1 | iex',
  },
  {
    num: '// 02',
    title: 'cargo install',
    description: 'Compile from source via crates.io toolchain.',
    command:
      'cargo install --git https://github.com/orlando-vazquez-career/seele.git --locked seele-cli',
    notes: 'Requires Rust 1.85+ (MSRV). 5-10 min first build.',
  },
  {
    num: '// 03',
    title: 'build from source',
    description: 'Clone and build the workspace.',
    command:
      'git clone https://github.com/orlando-vazquez-career/seele.git\ncd seele && cargo build --release -p seele-cli',
    notes: 'Output: target/release/seele',
  },
];
---

<section id="install" class="install">
  <div class="page-container install-inner">
    <header class="install-header">
      <span class="install-eyebrow">// INSTALL</span>
      <h2 class="install-heading">
        Three paths.<br />
        One binary.
      </h2>
      <p class="install-lead">
        Pick whichever fits. Full matrix in
        <a
          href="https://github.com/orlando-vazquez-career/seele/blob/main/docs/INSTALLATION.md"
          rel="noopener"
          target="_blank"
        >docs/INSTALLATION.md</a>.
      </p>
    </header>

    <div class="install-grid">
      {installPaths.map((p) => (
        <InstallCard {...p} />
      ))}
    </div>

    <details class="post-install">
      <summary>// after install — first save + search</summary>
      <pre><code>$ seele save "WAL is faster than DELETE" \
    "Postgres uses WAL by default since 9.1." \
    --project notes

$ seele search "crash recovery" --project notes

$ seele setup --agent claude-code   # wire MCP</code></pre>
    </details>
  </div>
</section>

<style>
  .install {
    padding-block: var(--space-20);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
  }

  .install-header {
    margin-bottom: var(--space-10);
    max-width: 60ch;
  }

  .install-eyebrow {
    display: block;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .install-heading {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
    margin-bottom: var(--space-5);
  }

  .install-lead {
    font-size: var(--text-base);
    color: var(--fg-muted);
    line-height: var(--leading-relaxed);
  }

  .install-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (max-width: 900px) {
    .install-grid {
      grid-template-columns: 1fr;
    }
  }

  .post-install {
    border-top: var(--border-base) solid var(--semantic-border-base);
    border-right: var(--border-base) solid var(--semantic-border-base);
    border-bottom: var(--border-base) solid var(--semantic-border-base);
    border-left: 0;
    padding: var(--space-3) var(--space-5);
    margin-left: var(--space-14);
    max-width: 720px;
  }

  .post-install summary {
    cursor: pointer;
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    padding-block: var(--space-2);
  }

  .post-install pre {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: var(--border-hair) solid var(--semantic-border-muted);
    font-size: var(--text-xs);
    color: var(--fg);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .post-install {
      margin-left: 0;
    }
  }
</style>
