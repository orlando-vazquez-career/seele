---
import InstallCard from './InstallCard.astro';

const installPaths = [
  {
    title: 'Install script',
    description: 'SHA256-verified pre-built binary. Linux, macOS, Windows.',
    command:
      'curl -fsSL https://raw.githubusercontent.com/orlando-vazquez-career/seele/main/scripts/install.sh | bash',
    recommended: true,
    notes: 'Windows: irm https://raw.githubusercontent.com/orlando-vazquez-career/seele/main/scripts/install.ps1 | iex',
  },
  {
    title: 'cargo install',
    description: 'Compile from source via crates.io toolchain.',
    command:
      'cargo install --git https://github.com/orlando-vazquez-career/seele.git --locked seele-cli',
    notes: 'Requires Rust 1.85+ (MSRV). ~5-10 min on first build.',
  },
  {
    title: 'Build from source',
    description: 'Clone and build the workspace.',
    command:
      'git clone https://github.com/orlando-vazquez-career/seele.git\ncd seele\ncargo build --release -p seele-cli',
    notes: 'Output binary at target/release/seele.',
  },
];
---

<section id="install" class="install">
  <div class="page-container install-inner">
    <p class="install-eyebrow silver-text">/ Install</p>
    <h2 class="install-heading">
      Three paths, <span class="gold-text">one binary</span>
    </h2>
    <p class="install-lead">
      Pick whichever fits. Full matrix + cache locations + ONNX fallback notes in
      <a
        href="https://github.com/orlando-vazquez-career/seele/blob/main/docs/INSTALLATION.md"
        rel="noopener"
        target="_blank"
      >docs/INSTALLATION.md</a>.
    </p>
    <div class="install-grid">
      {installPaths.map((p) => (
        <InstallCard {...p} />
      ))}
    </div>
    <details class="post-install">
      <summary>After install — first save + search</summary>
      <pre><code>seele save "WAL is faster than DELETE for crash recovery" \
  "Postgres uses WAL by default since 9.1." --project notes

seele search "crash recovery" --project notes

seele setup --agent claude-code   # wire MCP into Claude Code</code></pre>
    </details>
  </div>
</section>

<style>
  .install {
    padding-block: clamp(var(--space-16), 8vw, var(--space-20));
    border-top: 1px solid var(--semantic-border-subtle);
    background:
      radial-gradient(
        ellipse 80% 60% at 50% 100%,
        oklch(0.13 0.005 230) 0%,
        oklch(0.10 0.003 230) 70%,
        oklch(0.10 0.003 230) 100%
      );
  }

  .install-inner {
    container-type: inline-size;
  }

  .install-eyebrow {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-mega);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .install-heading {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }

  .install-lead {
    font-size: var(--text-base);
    color: var(--semantic-text-secondary);
    margin-bottom: var(--space-10);
    max-width: 640px;
  }

  .install-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @container (min-width: 900px) {
    .install-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-install {
    border: 1px solid var(--semantic-border-subtle);
    border-radius: var(--rounded-md);
    padding: var(--space-3) var(--space-4);
    background: var(--semantic-surface-elevated);
  }

  .post-install summary {
    cursor: pointer;
    color: var(--semantic-text-primary);
    font-size: var(--text-sm);
  }

  .post-install summary::marker {
    color: var(--semantic-text-gold);
  }

  .post-install pre {
    margin: var(--space-3) 0 var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: var(--semantic-surface-canvas);
    border: 1px solid var(--semantic-border-subtle);
    border-radius: var(--rounded-sm);
    font-size: var(--text-xs);
    color: var(--semantic-text-primary);
    line-height: var(--leading-relaxed);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
